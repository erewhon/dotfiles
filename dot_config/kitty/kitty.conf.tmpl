{{- $host := includeTemplate "host-profile" . | fromJson -}}
{{- if get $host "is_omarchy" -}}
# Omarchy variant. Colours follow the current Omarchy theme; remove the
# include to disconnect Kitty from it. Settings below override Omarchy's
# defaults in /etc/xdg/kitty/kitty.conf.
include ~/.local/state/omarchy/current/theme/kitty.conf

# Font
font_family JetBrainsMono Nerd Font Mono
{{- else -}}
# Kitty config. Values mirror the Konsole "Erewhon" profile.

# Font
font_family JetBrainsMono Nerd Font Mono
font_size 12

# Transparency and blur.
# macOS: the number is the blur radius. 80 looks right at this opacity.
# Linux (Wayland): any value above 0 only switches blur on. Strength is set
# in KDE: System Settings > Desktop Effects > Blur.
background_opacity 0.8
background_blur 80

# Colours
include breeze.conf
{{- end }}
