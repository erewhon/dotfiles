{{- $host := includeTemplate "host-profile" . | fromJson -}}
{{- if get $host "is_omarchy" -}}
#
# Omarchy variant: Omarchy's ghostty config with my preferences on top.
# Colours come from the current Omarchy theme, and the keybinds are the ones
# Omarchy's tmux and TUI setup expects, so neither is overridden here.
#

# Dynamic theme colors
config-file = ?"~/.local/state/omarchy/current/theme/ghostty.conf"

# Font. The size is Omarchy's: it is tuned to Hyprland's monitor scale, where
# the 16 used on macOS would come out roughly twice as large.
font-family = "JetBrainsMono Nerd Font"
font-style = Regular
font-size = 9

# Window
window-theme = ghostty
window-padding-x = 10
window-padding-y = 10
window-padding-balance = true
confirm-close-surface=false
resize-overlay = never
gtk-toolbar-style = flat

# Cursor styling
cursor-style = "block"
cursor-style-blink = false

# Cursor styling + SSH session terminfo
# (all shell integration options must be passed together)
# ssh-terminfo auto-installs xterm-ghostty terminfo on remote hosts.
shell-integration-features = no-cursor,ssh-env,ssh-terminfo

# Keyboard bindings
keybind = shift+insert=paste_from_clipboard
keybind = control+insert=copy_to_clipboard
# Send Shift+Enter as CSI-u so TUIs can distinguish it from Enter.
keybind = shift+enter=csi:13;2u
# Legacy encoding sends Alt+Shift+Enter the same as Alt+Enter; send CSI-u so tmux can match M-S-Enter.
keybind = alt+shift+enter=csi:13;4u
keybind = super+control+shift+alt+arrow_down=resize_split:down,100
keybind = super+control+shift+alt+arrow_up=resize_split:up,100
keybind = super+control+shift+alt+arrow_left=resize_split:left,100
keybind = super+control+shift+alt+arrow_right=resize_split:right,100

# Slowdown mouse scrolling
mouse-scroll-multiplier = 0.95

# Fix general slowness on hyprland (https://github.com/ghostty-org/ghostty/discussions/3224)
async-backend = epoll
{{- else -}}
#
# Minimal config
#
background = #0f0c29
background-opacity = 0.95
background-blur-radius = 20

theme = catppuccin-frappe

macos-titlebar-style = hidden

window-padding-x = 10
window-padding-y = 10
window-padding-balance = true
# window-padding-color = extend
keybind = shift+enter=text:\n

font-size = 16

# Auto-install xterm-ghostty terminfo on remote hosts when SSH-ing.
# Avoids "unknown terminal" complaints on machines we can't update.
shell-integration-features = ssh-terminfo
{{- end }}
