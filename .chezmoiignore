README.md

# Machine state, not configuration. Never manage these, even via `chezmoi add`.
# Shell history belongs to the host it was typed on.
.config/zsh/.zsh_history
# lazy.nvim rewrites the lockfile on every plugin update, so a tracked copy is
# always stale and an apply would roll plugins back.
**/lazy-lock.json
**/.DS_Store
**/*.backup
# Herdr rewrites these on every start or while it runs (docs, type files,
# shipped frame/icons, window and view state). Only our own layouts/mods and
# settings belong in the repo.
.config/herdr-app/AGENTS.md
.config/herdr-app/*.d.ts
.config/herdr-app/*.sock
.config/herdr-app/*.error
.config/herdr-app/frame
.config/herdr-app/icons
.config/herdr-app/data
.config/herdr-app/telemetry
.config/herdr-app/layouts/.state
.config/herdr-app/mods/*/gpui-kit.d.ts
.config/herdr-app/mods/*/jsconfig.json
.config/herdr-app/view.json
.config/herdr-app/shared.json
.config/herdr-app/seen.json
.config/herdr-app/installed.json
.config/herdr-app/window.json
.config/herdr-app/windows.json
.config/herdr-app/update-notes*
# pi loads every *.ts under extensions/ as an extension; the bun tests next to
# them stay in the source tree.
.pi/agent/extensions/*.test.ts
# router-session.ts is a symlink into the pitf checkout (it tags router requests
# with the Pi session id); hosts without smithy/pitf have nothing to point at.
{{ if not (stat (joinPath .chezmoi.homeDir "code/smithy/pitf/contrib/pi/router-session.ts")) }}
.pi/agent/extensions/router-session.ts
{{ end }}

# Host classification: defaults < catalog entry < [data.host_overrides] in chezmoi.toml
{{ $host := includeTemplate "host-profile" . | fromJson }}

# Skip Brewfile on non-brew hosts
{{ if not (get $host "has_brew") }}
.config/Brewfile
{{ end }}

# Skip desktop-only configs on remote hosts
{{ if get $host "is_remote" }}
.config/ghostty
.config/iterm
.config/kitty
.config/sketchybar
.config/wezterm
.local/share/konsole
{{ end }}

# Waybar config also goes to work machines, even ones answered "remote" at
# init (an unknown Linux box defaults to remote). Only home servers skip it.
# Installing and starting the bar is still gated to desks by 47-waybar.
{{ if and (get $host "is_remote") (get $host "is_personal") }}
.config/waybar
{{ end }}

# Skip personal-only configs on non-personal hosts
{{ if not (get $host "is_personal") }}
.config/opencode
.local/share/crush
# pi's models.json holds home-only model overrides. The router provider itself
# is the llm-router extension, which ships everywhere and reads
# LLM_ROUTER_BASE_URL / LLM_ROUTER_API_KEY on hosts without `ho secret`.
.pi/agent/models.json
.claude/agents/content-researcher.md
.claude/agents/script-writer.md
.claude/agents/thumbnail-ideas.md
.claude/commands/blog-draft.md
.claude/commands/video-outline.md
.claude/commands/stream-prep.md
.claude/skills/content-creation
.claude/skills/story-explanation
.claude/commands/do-feature.md
.claude/prompts
# Personal-infra skills: Forge/Nous task pipeline, the local `meta` agents,
# and the weekly-themes cadence. All depend on machines only reachable from home.
.claude/skills/forge-decompose
.claude/skills/meta-architect
.claude/skills/meta-book
.claude/skills/meta-edit
.claude/skills/meta-research
.claude/skills/meta-review
.claude/skills/nous-diagrams
.claude/skills/today
.claude/skills/week
# Reply-mode toggles for the Work Journal rules, which are personal-only in CLAUDE.md.
.claude/skills/discuss
.claude/skills/terse
# Vendored third-party Cloudflare skills. Large (~2.9MB) and only used on
# personal projects, so don't ship them to work hosts.
.claude/skills/agents-sdk
.claude/skills/cloudflare
.claude/skills/cloudflare-email-service
.claude/skills/cloudflare-one
.claude/skills/cloudflare-one-migrations
.claude/skills/durable-objects
.claude/skills/sandbox-sdk
.claude/skills/turnstile-spin
.claude/skills/web-perf
.claude/skills/workers-best-practices
.claude/skills/wrangler
{{ end }}

# Skip macOS-only configs on Linux
{{ if eq .chezmoi.os "linux" }}
.amethyst.yml
.config/iterm
.config/sketchybar
# The whole tree, not just the plist: ignoring only the file still left chezmoi
# creating an empty ~/Library/LaunchAgents on Linux boxes.
Library
{{ end }}

# Skip Linux-only configs on macOS
{{ if eq .chezmoi.os "darwin" }}
.config/systemd
.config/waybar
.local/share/konsole
{{ end }}
