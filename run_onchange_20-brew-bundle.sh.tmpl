#!/bin/sh
# {{ include "dot_config/Brewfile.tmpl" | sha256sum }}
# Run brew bundle when Brewfile changes.

{{ $host := includeTemplate "host-profile" . | fromJson -}}

{{ if not (get $host "has_brew") -}}
echo "[20-brew-bundle] skipping: host has no brew"
exit 0
{{ else -}}

set -e

if ! command -v brew >/dev/null 2>&1; then
    echo "[20-brew-bundle] brew not found, skipping"
    exit 0
fi

# Newer Homebrew refuses to load formulae from non-official taps until they
# are trusted, and `brew bundle` has no flag for it. Trust every tap the
# Brewfile names (idempotent; works before the tap is cloned).
if brew trust --help >/dev/null 2>&1; then
    sed -n 's/^tap "\([^"]*\)".*/\1/p' "$HOME/.config/Brewfile" |
        while read -r tap; do
            brew trust --quiet --tap "$tap"
        done
fi

echo "[20-brew-bundle] running brew bundle..."
brew bundle --file="$HOME/.config/Brewfile"
echo "[20-brew-bundle] done"
{{ end -}}
