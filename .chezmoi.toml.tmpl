{{- /*
  chezmoi config template. `chezmoi init` renders this into
  ~/.config/chezmoi/chezmoi.toml; it is NOT a managed dotfile.

  Host role is resolved in three layers (see .chezmoitemplates/host-profile):
    host_defaults  <  hosts.<hostname> (.chezmoidata.toml)  <  data.host_overrides (this file)

  The *Once prompts below persist their answers in the rendered config, so
  `chezmoi update` / `chezmoi apply` keep using them. To change an answer:
      chezmoi init --prompt --promptBool home=true      # non-interactive
      chezmoi init --prompt --promptBool remote=false   # a desk, not a server
      chezmoi init --prompt                             # re-ask
  (--promptBool is keyed by the prompt text, not the data path.)

  "remote" = a box you only reach over ssh. Answering false marks a machine
  you sit at, which gets the terminal emulators, sketchybar and the KDE
  desktop setup. It is a prompt rather than a catalog entry so that a work
  machine can get the desktop configs without its hostname being committed
  to this public repo.
*/ -}}
{{- $catalog := include ".chezmoidata.toml" | fromToml -}}
{{- $known := hasKey $catalog.hosts .chezmoi.hostname -}}
{{- $homeDefault := false -}}
{{- /* Unknown Macs are assumed to be sat at; unknown Linux boxes are assumed to be servers. */ -}}
{{- $remoteDefault := ne .chezmoi.os "darwin" -}}
{{- if $known -}}
{{-   $entry := index $catalog.hosts .chezmoi.hostname -}}
{{-   $homeDefault = get $entry "is_personal" -}}
{{-   if hasKey $entry "is_remote" }}{{ $remoteDefault = get $entry "is_remote" }}{{ end -}}
{{- end -}}
{{- /* `--prompt` re-asks every *Once prompt, so when flipping one answer the
       other should default to what is already stored, not to the catalog. */ -}}
{{- if hasKey . "host_overrides" -}}
{{-   if hasKey .host_overrides "is_personal" }}{{ $homeDefault = .host_overrides.is_personal }}{{ end -}}
{{-   if hasKey .host_overrides "is_remote" }}{{ $remoteDefault = .host_overrides.is_remote }}{{ end -}}
{{- end -}}
{{- /* Omarchy (Arch + Hyprland) is detected, not asked: it decides whose
       desktop configs win and that packages come from pacman, not Linuxbrew. */ -}}
{{- $omarchy := false -}}
{{- if and (eq .chezmoi.os "linux") (hasKey .chezmoi "osRelease") -}}
{{-   $omarchy = eq (get .chezmoi.osRelease "id") "omarchy" -}}
{{- end -}}
{{- /* An Omarchy box is a desktop by definition, so default it to not-remote
       unless an answer is already stored. */ -}}
{{- if and $omarchy (not (and (hasKey . "host_overrides") (hasKey .host_overrides "is_remote"))) -}}
{{-   $remoteDefault = false -}}
{{- end -}}
{{- $home := promptBoolOnce . "host_overrides.is_personal" "home" $homeDefault -}}
{{- $remote := promptBoolOnce . "host_overrides.is_remote" "remote" $remoteDefault -}}
# Rendered by `chezmoi init` from .chezmoi.toml.tmpl — edit the template, not this file.
# We want to auto-commit changes. Maybe eventually push.
encryption = "age"

[git]
    autoCommit = true
#   autoPush = true

[age]
    identity = "~/.config/chezmoi/key.txt"
    recipient = "age1s0xlqq3jkyl65dgdltqsup3s8mqc4jchkqc4cec5wywlg62wkdfsgv69zl"

# Per-machine answers. These override the host catalog in .chezmoidata.toml,
# so a host that isn't listed there (a fresh VM, a work laptop) can still be
# a home node or a desktop.
[data.host_overrides]
    is_personal = {{ $home }}
    is_remote = {{ $remote }}
    # Package managers are a fact of the box, not a choice: detect them.
    has_apt = {{ not (not (lookPath "apt-get")) }}
    has_dnf = {{ not (not (lookPath "dnf")) }}
    has_pacman = {{ not (not (lookPath "pacman")) }}
    is_omarchy = {{ $omarchy }}
{{- if $omarchy }}
    # Omarchy ships its tools through pacman and mise; a second copy from
    # Linuxbrew would shadow them on PATH.
    has_brew = false
{{- end }}
