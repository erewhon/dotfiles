#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.11"
# dependencies = ["pydantic>=2", "textual>=1.0"]
# ///
"""refview: read a text file on the left, see the code it points at on the right.

    refview FILE              open the browser
    refview -C DIR FILE       resolve references against project DIR
    refview --list FILE       print the detected references (also when piped)

It finds references to project files in the text and shows the target in the
right-hand pane, scrolled to the line or range, with the range highlighted.

Recognised forms (the path may be in backticks or a markdown link):

    src/app.py:120            src/app.py:120-180        src/app.py:120:7
    src/app.py#L120-L180      src/app.py lines 120-180  src/app.py (line 120)
    src/app.py L120-L180      line 120 of src/app.py    lines 3 to 9 in app.py
    src/app.py                (a bare path opens at the top)

A candidate only counts when it resolves to a real file: an absolute or
~ path, a path relative to the project root or to the document's directory,
or a unique-ish suffix of a tracked file (`server.py:88` finds
`nous_mcp/server.py`). Several matches: the shortest path is shown and `a`
cycles through the others.

The project root is `jj root` (else the git toplevel, else the document's
directory). For a work journal under .../journals/<slug>/ the root is decoded
from the slug.

Marks: a reference whose line is past the end of the file is shown in red
("stale"); one with several candidate files is shown in yellow.

Keys
  n/N          next/previous reference  enter  re-centre the current reference
  click        open a reference         r      list of all references
  tab          switch pane              a      next candidate file
  j/k g/G      scroll the focused pane  h/l    scroll sideways
  space/b      page down/up             e      open in $EDITOR at the line
  < >          move the divider         q      quit
"""

from __future__ import annotations

import argparse
import os
import re
import shlex
import subprocess
import sys
from pathlib import Path
from typing import ClassVar

from pydantic import BaseModel
from rich.style import Style
from rich.syntax import Syntax
from rich.text import Text
from textual import events, on
from textual.app import App, ComposeResult
from textual.binding import Binding, BindingType
from textual.containers import Horizontal
from textual.geometry import Size
from textual.screen import ModalScreen
from textual.scroll_view import ScrollView
from textual.strip import Strip
from textual.widgets import Footer, OptionList
from textual.widgets.option_list import Option

MAX_BYTES = 5_000_000  # larger targets are not loaded
MAX_HIGHLIGHT = 1_000_000  # larger targets are shown without syntax colours
MAX_INDEX = 200_000  # cap for the untracked-directory walk
SKIP_DIRS = {".git", ".jj", "node_modules", "__pycache__", ".venv", "target"}

TOKEN = re.compile(r"[\w.~/+@-]+")
RANGE_SEP = r"(?:[-–—]|to|through|thru)"
# path:12  path:12-40  path:12:7  path#L12  path#L12-L40
DIRECT = re.compile(r"`?(?::(\d+)(?:[-–](\d+)|:\d+)?|#L(\d+)(?:[-–]L?(\d+))?)(?!\w)")
# path lines 12-40   path (line 12)   path, at line 12   path L12-L40
AFTER = re.compile(
    r"[`'\"*)\]]*[\s,(]*(?:(?:at|on|around|near)\s+)?(?:lines?\s+|L)"
    rf"(\d+)(?:\s*{RANGE_SEP}\s*L?(\d+))?(?!\w)"
)
# line 12 of path   lines 3 to 9 in path
BEFORE = re.compile(
    rf"(?:\blines?\s+|\bL)(\d+)(?:\s*{RANGE_SEP}\s*L?(\d+))?\s+(?:of|in|at)\s+[`'\"*(\[]*$"
)

REF_STYLE = Style(color="bright_cyan", underline=True)
STALE_STYLE = Style(color="bright_red", underline=True)
AMBIG_STYLE = Style(color="bright_yellow", underline=True)
CURRENT_STYLE = Style(reverse=True, bold=True)
MARK_FILL = Style(bgcolor="#3b3a1f")
GUTTER = Style(color="#6c7480")
GUTTER_MARK = Style(color="#e5c07b", bold=True)


# ---------------------------------------------------------------- model


class Ref(BaseModel):
    """One reference found in the document."""

    idx: int
    doc_line: int  # 0-based line of the document
    start: int  # character span within that line
    end: int
    raw: str
    paths: list[Path]  # candidate files, best first
    counts: list[int]  # line count of each candidate
    pick: int = 0
    first: int | None = None  # 1-based, None for a bare path
    last: int | None = None

    @property
    def path(self) -> Path:
        return self.paths[self.pick]

    @property
    def stale(self) -> bool:
        return self.first is not None and self.first > self.counts[self.pick]

    @property
    def ambiguous(self) -> bool:
        return len(self.paths) > 1

    @property
    def span(self) -> str:
        if self.first is None:
            return ""
        if self.last is None or self.last == self.first:
            return f":{self.first}"
        return f":{self.first}-{self.last}"


# ---------------------------------------------------------------- project


def run(cmd: list[str], cwd: Path) -> str | None:
    try:
        p = subprocess.run(
            cmd, cwd=cwd, capture_output=True, text=True, timeout=20, check=False
        )
    except (OSError, subprocess.SubprocessError):
        return None
    return p.stdout if p.returncode == 0 else None


def slug_root(slug: str) -> Path | None:
    """Invert a journal slug (`export_home_me_code_x`) back to its directory."""
    tokens = slug.split("_")

    def walk(d: Path, rest: list[str]) -> Path | None:
        if not rest:
            return d
        for k in range(len(rest), 0, -1):
            cand = d / "_".join(rest[:k])
            if cand.is_dir() and (found := walk(cand, rest[k:])):
                return found
        return None

    return walk(Path("/"), tokens)


def find_root(doc: Path) -> Path:
    d = doc.parent
    if d.parent.name == "journals" and (r := slug_root(d.name)):
        return r
    for cmd in (
        ["jj", "--ignore-working-copy", "root"],
        ["git", "rev-parse", "--show-toplevel"],
    ):
        if (out := run(cmd, d)) and out.strip():
            return Path(out.strip())
    return d


class Project:
    """Resolves path-like tokens to files and remembers what it learned."""

    def __init__(self, root: Path, doc_dir: Path) -> None:
        self.root = root
        self.doc_dir = doc_dir
        self._by_name: dict[str, list[str]] | None = None
        self._resolved: dict[str, list[Path]] = {}
        self._counts: dict[Path, int] = {}

    def index(self) -> dict[str, list[str]]:
        if self._by_name is None:
            out = run(["jj", "--ignore-working-copy", "file", "list"], self.root)
            if out is None:
                out = run(["git", "ls-files"], self.root)
            files = out.splitlines() if out else self._walk()
            by_name: dict[str, list[str]] = {}
            for f in files:
                by_name.setdefault(f.rsplit("/", 1)[-1], []).append(f)
            self._by_name = by_name
        return self._by_name

    def _walk(self) -> list[str]:
        files: list[str] = []
        for base, dirs, names in os.walk(self.root):
            dirs[:] = [d for d in dirs if d not in SKIP_DIRS]
            rel = os.path.relpath(base, self.root)
            for n in names:
                files.append(n if rel == "." else f"{rel}/{n}")
            if len(files) > MAX_INDEX:
                break
        return files

    def resolve(self, token: str) -> list[Path]:
        if token not in self._resolved:
            self._resolved[token] = self._resolve(token)
        return self._resolved[token]

    def _resolve(self, token: str) -> list[Path]:
        if token.startswith("~"):
            p = Path(token).expanduser()
            return [p] if p.is_file() else []
        if token.startswith("/"):
            p = Path(token)
            return [p] if p.is_file() else []
        rel = token.removeprefix("./")
        for base in (self.root, self.doc_dir):
            p = base / rel
            if p.is_file():
                return [p.resolve()]
        parts = [x for x in rel.split("/") if x not in ("", ".")]
        if not parts or ".." in parts:
            return []
        # A path written from above the root: drop leading components.
        for i in range(1, len(parts)):
            p = self.root.joinpath(*parts[i:])
            if p.is_file() and parts[i - 1] == self.root.name:
                return [p]
        tail = "/".join(parts)
        hits = [
            f
            for f in self.index().get(parts[-1], [])
            if f == tail or f.endswith("/" + tail)
        ]
        hits.sort(key=lambda f: (f.count("/"), len(f), f))
        return [self.root / f for f in hits if (self.root / f).is_file()]

    def line_count(self, path: Path) -> int:
        if path not in self._counts:
            try:
                data = path.read_bytes()[:MAX_BYTES]
                self._counts[path] = data.count(b"\n") + (
                    0 if data.endswith(b"\n") or not data else 1
                )
            except OSError:
                self._counts[path] = 0
        return self._counts[path]

    def show(self, path: Path) -> str:
        if path != self.root:
            try:
                return str(path.relative_to(self.root))
            except ValueError:
                pass
        home = str(Path.home())
        s = str(path)
        return "~" + s[len(home) :] if s.startswith(home + "/") else s


# ---------------------------------------------------------------- detection


def line_range(a: str, b: str | None) -> tuple[int, int | None]:
    first = max(1, int(a))
    last = int(b) if b else None
    if last is not None and last < first:
        first, last = last, first
    return first, last


def find_refs(lines: list[str], project: Project) -> list[Ref]:
    refs: list[Ref] = []
    for n, line in enumerate(lines):
        pos = 0
        for m in TOKEN.finditer(line):
            if m.start() < pos:
                continue
            token = m.group().rstrip(".,-/~+@")
            if not token or token.startswith("//") or len(token) > 400:
                continue
            start, end = m.start(), m.start() + len(token)
            first: int | None = None
            last: int | None = None
            span_start, span_end = start, end
            if d := DIRECT.match(line, end):
                first, last = line_range(d[1] or d[3], d[2] or d[4])
                span_end = d.end()
            elif "/" not in token and "." not in token:
                continue  # a plain word needs an attached line number
            elif a := AFTER.match(line, end):
                first, last = line_range(a[1], a[2])
                span_end = a.end()
            elif b := BEFORE.search(line[:start]):
                first, last = line_range(b[1], b[2])
                span_start = b.start()
            paths = project.resolve(token)
            if not paths:
                continue
            if first is None and len(paths) > 1 and "/" not in token:
                continue  # a bare, ambiguous file name is more noise than signal
            refs.append(
                Ref(
                    idx=len(refs),
                    doc_line=n,
                    start=span_start,
                    end=span_end,
                    raw=line[span_start:span_end],
                    paths=paths,
                    counts=[project.line_count(p) for p in paths],
                    first=first,
                    last=last,
                )
            )
            pos = span_end
    return refs


def list_refs(refs: list[Ref], project: Project) -> int:
    for r in refs:
        flags = ""
        if r.stale:
            flags += f"  [stale: file has {r.counts[r.pick]} lines]"
        if r.ambiguous:
            flags += f"  [{len(r.paths)} candidates]"
        print(
            f"{r.doc_line + 1:>5}  {r.raw}  ->  {project.show(r.path)}{r.span}{flags}"
        )
    if not refs:
        print("no references found", file=sys.stderr)
    return 0


# ---------------------------------------------------------------- widgets


class LineView(ScrollView, can_focus=True):
    """A scrollable list of Rich Text lines drawn with the line API."""

    BINDINGS: ClassVar[list[BindingType]] = [
        Binding("j", "scroll_down", show=False),
        Binding("k", "scroll_up", show=False),
        Binding("h", "scroll_left", show=False),
        Binding("l", "scroll_right", show=False),
        Binding("g", "scroll_home", show=False),
        Binding("G", "scroll_end", show=False),
        Binding("space,ctrl+d,ctrl+f", "page_down", show=False),
        Binding("b,ctrl+u,ctrl+b", "page_up", show=False),
    ]

    def __init__(self, id: str) -> None:
        super().__init__(id=id)
        self.lines: list[Text] = []

    def set_lines(self, lines: list[Text], extra_width: int = 0) -> None:
        self.lines = lines
        width = max((ln.cell_len for ln in lines), default=0) + extra_width
        self.virtual_size = Size(width, len(lines))
        self.refresh()

    def line_text(self, idx: int) -> Text:
        return self.lines[idx]

    def line_fill(self, idx: int) -> Style | None:
        return None

    def render_line(self, y: int) -> Strip:
        sx, sy = self.scroll_offset
        idx = int(sy) + y
        width = self.text_width()
        base = self.rich_style
        if not 0 <= idx < len(self.lines):
            return Strip.blank(width, base)
        text = self.line_text(idx)
        fill = self.line_fill(idx)
        style = base + fill if fill else base
        strip = Strip(list(text.render(self.app.console)), text.cell_len)
        return strip.crop_extend(int(sx), int(sx) + width, style).apply_style(style)

    def text_width(self) -> int:
        """Columns available for text: the content area minus the scrollbar."""
        return self.scrollable_content_region.width

    def top(self) -> int:
        return int(self.scroll_offset.y)

    def shows(self, idx: int) -> bool:
        return self.top() <= idx < self.top() + self.size.height

    def go(self, y: int) -> None:
        self.scroll_to(x=0, y=max(0, y), animate=False, force=True)


class DocView(LineView):
    """The document, word-wrapped, with its references as click targets."""

    class Picked(events.Message):
        def __init__(self, ref: int) -> None:
            super().__init__()
            self.ref = ref

    def __init__(self, id: str, source: list[str], refs: list[Ref]) -> None:
        super().__init__(id=id)
        self.source = source
        self.refs = refs
        self.current: int | None = None
        self.src_of: list[int] = []  # wrapped line -> source line
        self.ref_line: dict[int, int] = {}  # ref -> first wrapped line
        self._width = 0
        self._fitting = False

    def styled(self) -> list[Text]:
        by_line: dict[int, list[Ref]] = {}
        for r in self.refs:
            by_line.setdefault(r.doc_line, []).append(r)
        out: list[Text] = []
        fenced = False
        for n, raw in enumerate(self.source):
            t = Text(raw.expandtabs(4))
            exp = len(raw) != len(t.plain)  # tabs moved the columns
            fence = raw.lstrip().startswith(("```", "~~~"))
            if fence or fenced:
                t.stylize("dim")
                fenced = fenced != fence
            elif re.match(r"#{1,6} ", raw):
                t.stylize("bold bright_magenta")
            else:
                t.highlight_regex(r"\*\*[^*\n]+\*\*", "bold")
                t.highlight_regex(r"`[^`\n]+`", "bright_green")
            for r in by_line.get(n, []):
                s, e = r.start, r.end
                if exp:
                    s = len(raw[:s].expandtabs(4))
                    e = len(raw[:e].expandtabs(4))
                look = (
                    STALE_STYLE
                    if r.stale
                    else AMBIG_STYLE
                    if r.ambiguous
                    else REF_STYLE
                )
                t.stylize(look + Style(meta={"ref": r.idx}), s, e)
            out.append(t)
        return out

    def rewrap(self) -> None:
        width = max(10, self.text_width())
        keep = self.src_of[self.top()] if self.top() < len(self.src_of) else 0
        self._width = width
        lines: list[Text] = []
        self.src_of = []
        self.ref_line = {}
        first_of: dict[int, int] = {}
        for n, t in enumerate(self.styled()):
            first_of[n] = len(lines)
            pieces = list(t.wrap(self.app.console, width)) or [Text("")]
            for piece in pieces:
                for sp in piece.spans:
                    ref = ref_of(sp.style)
                    if ref is not None:
                        self.ref_line.setdefault(ref, len(lines))
                lines.append(piece)
                self.src_of.append(n)
        self.set_lines(lines)
        self.virtual_size = Size(width, len(lines))
        if keep:
            self.call_after_refresh(self.go, first_of.get(keep, 0))

    def render_line(self, y: int) -> Strip:
        # The usable width also changes when the scrollbar comes or goes,
        # which sends no resize event, so the check lives where lines are drawn.
        if max(10, self.text_width()) != self._width and not self._fitting:
            self._fitting = True
            self.call_after_refresh(self.fit)
        return super().render_line(y)

    def fit(self) -> None:
        self._fitting = False
        if max(10, self.text_width()) != self._width:
            self.rewrap()

    def line_text(self, idx: int) -> Text:
        text = self.lines[idx]
        if self.current is None:
            return text
        hits = [sp for sp in text.spans if ref_of(sp.style) == self.current]
        if not hits:
            return text
        text = text.copy()
        for sp in hits:
            text.stylize(CURRENT_STYLE, sp.start, sp.end)
        return text

    def set_current(self, ref: int | None, reveal: bool) -> None:
        self.current = ref
        self.refresh()
        if ref is None or not reveal:
            return
        line = self.ref_line.get(ref)
        if line is not None and not self.shows(line):
            self.go(line - self.size.height // 3)

    def on_click(self, event: events.Click) -> None:
        off = event.get_content_offset(self)
        if off is None:
            return
        idx = self.top() + off.y
        if not 0 <= idx < len(self.lines):
            return
        x = off.x + int(self.scroll_offset.x)
        for sp in self.lines[idx].spans:
            ref = ref_of(sp.style)
            if ref is not None and sp.start <= x < sp.end:
                self.post_message(self.Picked(ref))
                return


def ref_of(style: str | Style) -> int | None:
    if isinstance(style, Style) and style.meta:
        value = style.meta.get("ref")
        return value if isinstance(value, int) else None
    return None


class CodeView(LineView):
    """The referenced file with a line-number gutter and a marked range."""

    def __init__(self, id: str) -> None:
        super().__init__(id=id)
        self.mark: range = range(0)
        self.gut_w = 4

    def show_file(self, lines: list[Text], mark: range) -> None:
        self.mark = mark
        self.gut_w = len(str(max(1, len(lines)))) + 3
        self.set_lines(lines, extra_width=self.gut_w)

    def line_text(self, idx: int) -> Text:
        marked = idx in self.mark
        num = f"{idx + 1:>{self.gut_w - 3}}"
        return Text.assemble(
            ("▌" if marked else " ", GUTTER_MARK),
            (f"{num}  ", GUTTER_MARK if marked else GUTTER),
            self.lines[idx],
        )

    def line_fill(self, idx: int) -> Style | None:
        return MARK_FILL if idx in self.mark else None


class RefList(ModalScreen[int | None]):
    """Every reference in the document; enter jumps to one."""

    BINDINGS: ClassVar[list[BindingType]] = [
        Binding("escape,q,r", "dismiss(None)", "close"),
        Binding("j", "cursor('down')", show=False),
        Binding("k", "cursor('up')", show=False),
    ]
    DEFAULT_CSS = """
    RefList { align: center middle; }
    RefList OptionList { width: 90%; height: 80%; border: round $accent; }
    """

    def __init__(self, refs: list[Ref], project: Project, current: int | None) -> None:
        super().__init__()
        self.refs = refs
        self.project = project
        self.current = current

    def compose(self) -> ComposeResult:
        options: list[Option] = []
        for r in self.refs:
            label = Text.assemble(
                (f"{r.doc_line + 1:>5}  ", "dim"),
                self.project.show(r.path) + r.span,
            )
            if r.stale:
                label.append("  stale", "bright_red")
            if r.ambiguous:
                label.append(f"  {r.pick + 1} of {len(r.paths)}", "bright_yellow")
            options.append(Option(label, id=str(r.idx)))
        ol = OptionList(*options)
        ol.border_title = "references (document line, target)"
        yield ol

    def on_mount(self) -> None:
        ol = self.query_one(OptionList)
        if self.current is not None:
            ol.highlighted = self.current
        ol.focus()

    def action_cursor(self, way: str) -> None:
        ol = self.query_one(OptionList)
        if way == "down":
            ol.action_cursor_down()
        else:
            ol.action_cursor_up()

    @on(OptionList.OptionSelected)
    def chosen(self, event: OptionList.OptionSelected) -> None:
        self.dismiss(int(event.option.id or 0))


# ---------------------------------------------------------------- app


def plain_style(style: str | Style) -> str | Style:
    """Drop a theme's background so the range highlight shows through."""
    if isinstance(style, Style) and style.bgcolor is not None:
        return Style(
            color=style.color,
            bold=style.bold,
            italic=style.italic,
            underline=style.underline,
        )
    return style


def load_code(path: Path) -> list[Text]:
    try:
        if path.stat().st_size > MAX_BYTES:
            return [
                Text(f"file is larger than {MAX_BYTES // 1_000_000} MB, not loaded")
            ]
        data = path.read_bytes()
    except OSError as err:
        return [Text(f"cannot read: {err}")]
    if b"\0" in data[:8192]:
        return [Text("binary file")]
    code = data.decode("utf-8", errors="replace").expandtabs(4)
    code = code.removesuffix("\n")
    if len(data) > MAX_HIGHLIGHT:
        return [Text(ln) for ln in code.split("\n")]
    lexer = Syntax.guess_lexer(str(path), code)
    text = Syntax(code, lexer, theme="monokai").highlight(code)
    text.rstrip()
    lines = list(text.split("\n"))
    for ln in lines:
        ln.style = Style.null()
        ln.spans[:] = [sp._replace(style=plain_style(sp.style)) for sp in ln.spans]
    return lines


class RefView(App[None]):
    CSS = """
    LineView { border: round $panel; scrollbar-size-vertical: 1; }
    LineView:focus { border: round $accent; }
    #doc { overflow-x: hidden; }
    #code { width: 1fr; scrollbar-size-horizontal: 1; }
    """
    BINDINGS: ClassVar[list[BindingType]] = [
        Binding("n", "step(1)", "next ref"),
        Binding("N", "step(-1)", "prev ref"),
        Binding("enter", "recentre", "re-centre"),
        Binding("r", "ref_list", "list"),
        Binding("a", "candidate", "candidate"),
        Binding("e", "edit", "edit"),
        Binding("tab", "swap", "pane"),
        Binding("<", "divider(-5)", show=False),
        Binding(">", "divider(5)", show=False),
        Binding("q", "quit", "quit"),
    ]

    def __init__(
        self, doc: Path, source: list[str], refs: list[Ref], project: Project
    ) -> None:
        super().__init__()
        self.doc = doc
        self.source = source
        self.refs = refs
        self.project = project
        self.current: int | None = None
        self.split = 45
        self._code: dict[Path, list[Text]] = {}

    def compose(self) -> ComposeResult:
        with Horizontal():
            yield DocView("doc", self.source, self.refs)
            yield CodeView("code")
        yield Footer()

    @property
    def doc_view(self) -> DocView:
        return self.query_one(DocView)

    @property
    def code_view(self) -> CodeView:
        return self.query_one(CodeView)

    def on_mount(self) -> None:
        self.title = "refview"
        self.doc_view.styles.width = f"{self.split}%"
        n = len(self.refs)
        self.doc_view.border_title = (
            f"{self.project.show(self.doc)}  ({n} reference{'' if n == 1 else 's'})"
        )
        self.doc_view.border_subtitle = f"root {self.project.show(self.project.root)}"
        self.doc_view.focus()
        if self.refs:
            self.call_after_refresh(self.select_ref, 0, False)
        else:
            self.code_view.border_title = "no references found"
            self.code_view.show_file([], range(0))

    # -- selection

    def select_ref(self, idx: int, reveal: bool = True) -> None:
        self.current = idx
        self.doc_view.set_current(idx, reveal)
        self.open_ref(self.refs[idx])

    def open_ref(self, ref: Ref) -> None:
        path = ref.path
        if path not in self._code:
            self._code[path] = load_code(path)
        lines = self._code[path]
        view = self.code_view
        mark = range(0)
        target = 0
        if ref.first is not None:
            lo = min(ref.first, max(1, len(lines)))
            hi = min(ref.last or ref.first, max(1, len(lines)))
            if not ref.stale:
                mark = range(lo - 1, hi)
            height = view.size.height
            span = hi - lo + 1
            lead = height // 3 if span < height - height // 3 else 1
            target = lo - 1 - lead
        title = Text(f"{self.project.show(path)}{ref.span}")
        if ref.stale:
            title.append(
                f"  stale: file has {ref.counts[ref.pick]} lines", "bright_red"
            )
        if ref.ambiguous:
            title.append(
                f"  candidate {ref.pick + 1} of {len(ref.paths)} (a)", "bright_yellow"
            )
        view.border_title = title
        view.border_subtitle = (
            f"{self.current + 1 if self.current is not None else 0}/{len(self.refs)}"
        )
        view.show_file(lines, mark)
        view.call_after_refresh(view.go, target)

    @on(DocView.Picked)
    def picked(self, event: DocView.Picked) -> None:
        self.select_ref(event.ref, reveal=False)

    def action_step(self, way: int) -> None:
        if not self.refs:
            return
        doc = self.doc_view
        cur = self.current
        here = doc.ref_line.get(cur) if cur is not None else None
        if cur is not None and (here is None or doc.shows(here)):
            nxt = cur + way
        elif way > 0:  # scrolled away: take the first reference on screen or below
            below = [i for i, y in sorted(doc.ref_line.items()) if y >= doc.top()]
            nxt = below[0] if below else len(self.refs) - 1
        else:
            bottom = doc.top() + doc.size.height
            above = [i for i, y in sorted(doc.ref_line.items()) if y < bottom]
            nxt = above[-1] if above else 0
        nxt = max(0, min(len(self.refs) - 1, nxt))
        if nxt == cur:
            self.bell()
        self.select_ref(nxt)

    def action_recentre(self) -> None:
        if self.current is not None:
            self.select_ref(self.current)

    def action_candidate(self) -> None:
        if self.current is None:
            return
        ref = self.refs[self.current]
        if not ref.ambiguous:
            self.bell()
            return
        ref.pick = (ref.pick + 1) % len(ref.paths)
        self.doc_view.rewrap()  # the stale colour may have changed
        self.open_ref(ref)

    def action_ref_list(self) -> None:
        if not self.refs:
            return

        def done(idx: int | None) -> None:
            if idx is not None:
                self.select_ref(idx)

        self.push_screen(RefList(self.refs, self.project, self.current), done)

    def action_edit(self) -> None:
        if self.current is None:
            return
        ref = self.refs[self.current]
        editor = shlex.split(
            os.environ.get("VISUAL") or os.environ.get("EDITOR") or "vi"
        )
        with self.suspend():
            subprocess.run([*editor, f"+{ref.first or 1}", str(ref.path)], check=False)
        self._code.pop(ref.path, None)
        self.open_ref(ref)

    def action_swap(self) -> None:
        (self.code_view if self.doc_view.has_focus else self.doc_view).focus()

    def action_divider(self, by: int) -> None:
        self.split = max(20, min(80, self.split + by))
        self.doc_view.styles.width = f"{self.split}%"


# ---------------------------------------------------------------- main


def main() -> int:
    ap = argparse.ArgumentParser(
        description="Browse a text file next to the code it references.",
        epilog="Keys and reference forms: see the docstring at the top of this script.",
    )
    ap.add_argument("file", type=Path)
    ap.add_argument(
        "-C", dest="root", type=Path, help="project root to resolve against"
    )
    ap.add_argument("--list", action="store_true", help="print the references and exit")
    args = ap.parse_args()

    doc: Path = args.file.expanduser().resolve()
    if not doc.is_file():
        print(f"refview: not a file: {args.file}", file=sys.stderr)
        return 2
    if doc.stat().st_size > MAX_BYTES:
        print(f"refview: {args.file} is too large", file=sys.stderr)
        return 2
    root = args.root.expanduser().resolve() if args.root else find_root(doc)
    if not root.is_dir():
        print(f"refview: not a directory: {root}", file=sys.stderr)
        return 2
    source = doc.read_text(encoding="utf-8", errors="replace").splitlines()
    project = Project(root, doc.parent)
    refs = find_refs(source, project)
    if args.list or not sys.stdout.isatty():
        return list_refs(refs, project)
    RefView(doc, source, refs, project).run()
    return 0


if __name__ == "__main__":
    sys.exit(main())
