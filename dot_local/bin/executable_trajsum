#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.11"
# dependencies = ["pydantic>=2"]
# ///
"""trajsum: summarize coding-agent trajectories and session transcripts.

    trajsum FILE                     detailed summary of one run
    trajsum FILE... | DIR...         one row per run, plus totals
    trajsum --json FILE...           machine-readable (one object per run)
    trajsum --detail DIR             full summary for every run in DIR
    trajsum --top 20 FILE            longer command / file lists

Formats (auto-detected):
  atif    Harbor `agent/trajectory.json` (ATIF, e.g. terminus-2). A Harbor
          job or trial directory works too; reward and exception come from
          the trial's result.json.
  pi      pi (pi.dev) session .jsonl (~/.pi/agent/sessions/...)
  claude  Claude Code session .jsonl (~/.claude/projects/...)
  cortex  Codeium Cortex step arrays (Windsurf / Google Antigravity exports):
          steps with step_index, source, type (USER_INPUT, PLANNER_RESPONSE,
          ...), status, created_at, *_tokens and tool_calls[{name, args}].
          The array may be the whole document or nested under any key.
  codex   OpenAI Codex CLI rollout .jsonl (~/.codex/sessions/YYYY/MM/DD/...)
  opencode
          `opencode session export <id>` JSON, or OpenCode's SQLite store
          (~/.local/share/opencode/opencode.db: one run per session; filter
          with --session ID-or-title-substring).

Files written by shell commands (redirection, tee, sed -i, cp/mv, touch,
Path.write_text...) are inferred heuristically and listed separately from
files changed by real edit/write tools.
"""

from __future__ import annotations

import argparse
import itertools
import json
import os
import re
import shlex
import sqlite3
import sys
from collections import Counter
from datetime import UTC, datetime
from pathlib import Path
from typing import Any, Literal

from pydantic import BaseModel, Field

Format = Literal["atif", "pi", "claude", "cortex", "codex", "opencode", "opencode-db"]


# ---------------------------------------------------------------- model


class ToolCall(BaseModel):
    name: str
    command: str | None = None  # shell command, if this call runs one
    path: str | None = None  # file path, if this call reads/edits/writes one
    action: Literal["read", "edit", "write", "other"] = "other"
    error: bool = False


class Tokens(BaseModel):
    input: int = 0
    output: int = 0
    cache_read: int = 0
    cache_write: int = 0
    reasoning: int = 0
    peak_context: int = 0
    cost_usd: float = 0.0


class Summary(BaseModel):
    file: str
    format: Format
    session_id: str | None = None
    agent: str | None = None
    models: list[str] = Field(default_factory=list)
    cwd: str | None = None
    started: str | None = None
    ended: str | None = None
    duration_s: float | None = None  # first to last event
    active_s: float | None = None  # same, minus idle gaps over IDLE_GAP_S
    # turns
    agent_steps: int = 0  # LLM responses
    user_messages: int = 0
    steps_with_tools: int = 0
    steps_without_tools: int = 0
    reasoning_steps: int = 0
    reasoning_chars: int = 0
    branches: int = 0  # pi: abandoned branches in the entry tree
    step_types: dict[str, int] = Field(default_factory=dict)  # cortex: raw step types
    step_statuses: dict[str, int] = Field(
        default_factory=dict
    )  # cortex: non-DONE statuses
    # tools
    tool_calls: int = 0
    tools: dict[str, int] = Field(default_factory=dict)
    tool_errors: int = 0
    tool_errors_by_tool: dict[str, int] = Field(default_factory=dict)
    parse_errors: int = 0  # ATIF: "Previous response had parsing errors"
    parse_error_kinds: dict[str, int] = Field(default_factory=dict)
    stop_reasons: dict[str, int] = Field(default_factory=dict)
    # commands
    commands: int = 0
    unique_commands: int = 0
    failed_commands: int = 0
    command_heads: dict[str, int] = Field(default_factory=dict)  # first word
    top_commands: list[str] = Field(default_factory=list)
    # files
    files_read: list[str] = Field(default_factory=list)
    files_edited: list[str] = Field(default_factory=list)
    files_written: list[str] = Field(default_factory=list)  # write/create tool
    files_deleted: list[str] = Field(default_factory=list)  # delete via patch tool
    files_shell_written: list[str] = Field(default_factory=list)  # heuristic
    files_shell_deleted: list[str] = Field(default_factory=list)  # heuristic
    edit_ops: int = 0
    # usage
    tokens: Tokens = Field(default_factory=Tokens)
    # harbor trial result
    reward: float | None = None
    exception: str | None = None
    final_message: str | None = None


# ---------------------------------------------------------------- helpers


def ts(value: Any) -> datetime | None:
    if value is None:
        return None
    if isinstance(value, (int, float)):
        return datetime.fromtimestamp(value / (1000 if value > 1e11 else 1), tz=UTC)
    try:
        return datetime.fromisoformat(str(value))
    except ValueError:
        return None


def text_of(content: Any) -> str:
    if content is None:
        return ""
    if isinstance(content, str):
        return content
    if isinstance(content, list):
        return "\n".join(text_of(c) for c in content)
    if isinstance(content, dict):
        for k in ("text", "content", "output"):
            if k in content:
                return text_of(content[k])
    return ""


PY_WRITE = re.compile(
    r"""(?:Path\(\s*['"]([^'"]+)['"]\s*\)\.write_(?:text|bytes)|open\(\s*['"]([^'"]+)['"]\s*,\s*['"][wa])"""
)
HEREDOC = re.compile(
    r"<<-?\s*['\"]?(\w+)['\"]?[^\n]*\n.*?\n\s*\1\s*(?:\n|$)", re.DOTALL
)
OPERATORS = {";", "&&", "||", "|", "&", "(", ")", ";;", "|&"}
WRAPPERS = {"sudo", "env", "command", "time", "nohup", "exec"}


def tokens(cmd: str) -> list[str]:
    """Shell tokens with operators split out; heredoc bodies dropped."""
    body = HEREDOC.sub("\n", cmd).replace("\n", " ; ")
    lex = shlex.shlex(body, posix=True, punctuation_chars=True)
    lex.whitespace_split = True
    lex.commenters = ""
    try:
        return list(lex)
    except ValueError:  # unbalanced quotes: fall back to whitespace
        return body.split()


def shell_effects(cmd: str) -> tuple[set[str], set[str]]:
    """Best-effort: files a shell command writes and deletes."""
    written: set[str] = set()
    deleted: set[str] = set()
    for m in PY_WRITE.finditer(cmd):
        written.add(m.group(1) or m.group(2))
    segments: list[list[str]] = [[]]
    toks = tokens(cmd)
    i = 0
    while i < len(toks):
        t = toks[i]
        if t in OPERATORS:
            segments.append([])
        elif t in (">", ">>", ">|", "&>", "&>>") and i + 1 < len(toks):
            # `2>&1` tokenizes as '2', '>&', '1'; `2>/dev/null` as '2', '>', '/dev/null'
            target = toks[i + 1]
            if not target.startswith(("&", "/dev/")):
                written.add(target)
            if segments[-1] and segments[-1][-1].isdigit():
                segments[-1].pop()  # fd number belongs to the redirect
            i += 1
        elif t in ("<", "<<", "<<<", ">&", "<&") and i + 1 < len(toks):
            if segments[-1] and segments[-1][-1].isdigit():
                segments[-1].pop()
            i += 1
        else:
            segments[-1].append(t)
        i += 1
    for words in segments:
        while words and (
            words[0] in WRAPPERS or ("=" in words[0] and not words[0].startswith("-"))
        ):
            words = words[1:]
        if not words:
            continue
        head = os.path.basename(words[0])
        args = [w for w in words[1:] if not w.startswith("-")]
        if head in ("tee", "touch"):
            written.update(args)
        elif head in ("cp", "mv", "install") and len(args) >= 2:
            written.add(args[-1])
            if head == "mv":
                deleted.update(args[:-1])
        elif head == "rm":
            deleted.update(args)
        elif head in ("sed", "perl") and any(
            w.startswith(("-i", "-pi")) for w in words[1:]
        ):
            written.update(args[1:])  # args[0] is the script

    def clean(paths: set[str]) -> set[str]:
        return {
            p
            for p in paths
            if p and not p.startswith("$") and "*" not in p and p not in (".", "..")
        }

    return clean(written), clean(deleted)


def first_line(cmd: str, width: int = 100) -> str:
    line = cmd.strip().splitlines()[0] if cmd.strip() else ""
    more = " …" if len(cmd.strip().splitlines()) > 1 else ""
    return (line[: width - 1] + "…" if len(line) > width else line) + more


def command_head(cmd: str) -> str:
    for segment in re.split(r"&&|\|\||;|\n", cmd):
        words = segment.strip().split()
        while words and (
            "=" in words[0] or words[0] in ("sudo", "env", "cd", "time", "timeout")
        ):
            if words[0] == "cd":
                break
            words = words[1:] if words[0] != "timeout" else words[2:]
        if words and words[0] != "cd":
            return os.path.basename(words[0])
    return "cd"


IDLE_GAP_S = 300  # gaps longer than this (user away, resumed session) are not "active"
CONTROL_KEYS = re.compile(r"^(C-[a-z]|Enter|Escape|q|\s*)$")


# ---------------------------------------------------------------- collector


class Collector:
    def __init__(self, path: Path, fmt: Format) -> None:
        self.s = Summary(file=str(path), format=fmt)
        self.calls: list[ToolCall] = []
        self.times: list[datetime] = []
        self.models: Counter[str] = Counter()
        self.stops: Counter[str] = Counter()
        self.parse_kinds: Counter[str] = Counter()
        self.patch_deleted: list[str] = []  # files deleted by apply_patch
        self.extra_paths: list[ToolCall] = []  # extra files of a multi-file patch

    def when(self, value: Any) -> None:
        t = ts(value)
        if t:
            self.times.append(t)

    def usage(
        self,
        inp: int,
        out: int,
        cr: int = 0,
        cw: int = 0,
        reasoning: int = 0,
        cost: float = 0.0,
    ) -> None:
        t = self.s.tokens
        t.input += inp
        t.output += out
        t.cache_read += cr
        t.cache_write += cw
        t.reasoning += reasoning
        t.cost_usd += cost
        t.peak_context = max(t.peak_context, inp + cr + cw)

    def finish(self, top: int) -> Summary:
        s = self.s
        s.models = [m for m, _ in self.models.most_common()]
        s.stop_reasons = dict(self.stops.most_common())
        s.parse_error_kinds = dict(self.parse_kinds.most_common())
        if self.times:
            a, b = min(self.times), max(self.times)
            s.started, s.ended = (
                a.isoformat(timespec="seconds"),
                b.isoformat(timespec="seconds"),
            )
            s.duration_s = round((b - a).total_seconds(), 1)
            ordered = sorted(self.times)
            gaps = ((y - x).total_seconds() for x, y in itertools.pairwise(ordered))
            s.active_s = round(sum(g for g in gaps if g <= IDLE_GAP_S), 1)
        s.tool_calls = len(self.calls)
        s.tools = dict(Counter(c.name for c in self.calls).most_common())
        s.tool_errors = sum(c.error for c in self.calls)
        s.tool_errors_by_tool = dict(
            Counter(c.name for c in self.calls if c.error).most_common()
        )
        cmds = [c for c in self.calls if c.command]
        s.commands = len(cmds)
        s.unique_commands = len({c.command for c in cmds})
        s.failed_commands = sum(c.error for c in cmds)
        s.command_heads = dict(
            Counter(command_head(c.command or "") for c in cmds).most_common(top)
        )
        s.top_commands = [first_line(c.command or "") for c in cmds][:top]

        def ordered(action: str) -> list[str]:
            return list(
                dict.fromkeys(
                    c.path
                    for c in self.calls + self.extra_paths
                    if c.action == action and c.path
                )
            )

        s.files_read = ordered("read")
        s.files_edited = ordered("edit")
        s.files_written = ordered("write")
        s.edit_ops = sum(c.action == "edit" for c in self.calls + self.extra_paths)
        s.files_deleted = list(dict.fromkeys(self.patch_deleted))
        tool_touched = set(s.files_edited) | set(s.files_written)
        written: dict[str, None] = {}
        deleted: dict[str, None] = {}
        for c in cmds:
            w, d = shell_effects(c.command or "")
            written.update(dict.fromkeys(sorted(w - tool_touched)))
            deleted.update(dict.fromkeys(sorted(d)))
        s.files_shell_written = list(written)
        s.files_shell_deleted = list(deleted)
        return s


# ---------------------------------------------------------------- parsers


def parse_atif(path: Path, top: int) -> Summary:
    doc = json.loads(path.read_text())
    c = Collector(path, "atif")
    s = c.s
    s.session_id = doc.get("session_id")
    agent = doc.get("agent") or {}
    s.agent = (
        " ".join(x for x in (agent.get("name"), agent.get("version")) if x) or None
    )
    if agent.get("model_name"):
        c.models[agent["model_name"]] += 0
    for step in doc.get("steps", []):
        c.when(step.get("timestamp"))
        if step.get("source") == "user":
            s.user_messages += 1
            continue
        if step.get("source") != "agent":
            continue
        s.agent_steps += 1
        if step.get("model_name"):
            c.models[step["model_name"]] += 1
        m = step.get("metrics") or {}
        c.usage(
            m.get("prompt_tokens") or 0,
            m.get("completion_tokens") or 0,
            m.get("cached_tokens") or 0,
            0,
            0,
            m.get("cost_usd") or 0.0,
        )
        if step.get("reasoning_content"):
            s.reasoning_steps += 1
            s.reasoning_chars += len(step["reasoning_content"])
        obs = text_of((step.get("observation") or {}).get("results"))
        if "Previous response had parsing errors" in obs:
            s.parse_errors += 1
            kind = re.search(r"ERROR: ([^\n|:]+)", obs)
            c.parse_kinds[(kind.group(1) if kind else "unknown").strip()[:60]] += 1
        calls = step.get("tool_calls") or []
        s.steps_with_tools += bool(calls)
        s.steps_without_tools += not calls
        for tc in calls:
            name = tc.get("function_name") or "?"
            args = tc.get("arguments") or {}
            cmd = args.get("keystrokes") or args.get("command")
            if isinstance(cmd, str) and CONTROL_KEYS.match(cmd.strip()):
                cmd = None  # bare key presses (C-c, Enter) are not commands
            c.calls.append(
                ToolCall(
                    name=name,
                    command=cmd.rstrip("\n") if isinstance(cmd, str) else None,
                )
            )
        if step.get("message"):
            s.final_message = text_of(step["message"])
    fm = doc.get("final_metrics") or {}
    if fm and not s.tokens.input:  # per-step metrics missing: fall back to totals
        c.usage(
            fm.get("total_prompt_tokens") or 0,
            fm.get("total_completion_tokens") or 0,
            fm.get("total_cached_tokens") or 0,
        )
    trial = path.parent.parent / "result.json"  # <trial>/agent/trajectory.json
    if trial.exists():
        r = json.loads(trial.read_text())
        rewards = (r.get("verifier_result") or {}).get("rewards") or {}
        s.reward = rewards.get("reward")
        s.exception = (r.get("exception_info") or {}).get("exception_type")
        c.when(r.get("started_at"))
        c.when(r.get("finished_at"))
        s.cwd = r.get("task_name")
    return c.finish(top)


PI_PATH_TOOLS = {"read": "read", "edit": "edit", "write": "write"}


def parse_pi(path: Path, top: int) -> Summary:
    entries = [
        json.loads(line) for line in path.read_text().splitlines() if line.strip()
    ]
    c = Collector(path, "pi")
    s = c.s
    by_id = {e["id"]: e for e in entries if e.get("id")}
    # pi entries form a tree (edits/retries branch). Summarize the active path:
    # walk back from the last entry; count leaves to report branches.
    parents = {e.get("parentId") for e in entries}
    leaves = [
        e
        for e in entries
        if e.get("id") and e["id"] not in parents and e.get("type") != "session"
    ]
    s.branches = max(0, len(leaves) - 1)
    active: list[dict[str, Any]] = []
    node = entries[-1] if entries else None
    while node is not None:
        active.append(node)
        node = by_id.get(node.get("parentId")) if node.get("parentId") else None
    active.reverse()
    header = next((e for e in entries if e.get("type") == "session"), {})
    s.session_id, s.cwd, s.agent = header.get("id"), header.get("cwd"), "pi"
    c.when(header.get("timestamp"))
    pending: dict[str, ToolCall] = {}
    for e in active if active else entries:
        c.when(e.get("timestamp"))
        if e.get("type") != "message":
            continue
        m = e.get("message") or {}
        role = m.get("role")
        if role == "user":
            s.user_messages += 1
        elif role == "bashExecution":  # user ran `!cmd` in the pi prompt
            c.calls.append(
                ToolCall(
                    name="user-bash",
                    command=m.get("command"),
                    error=(m.get("exitCode") or 0) != 0,
                )
            )
        elif role == "assistant":
            s.agent_steps += 1
            if m.get("model"):
                c.models[
                    f"{m.get('provider')}/{m['model']}"
                    if m.get("provider")
                    else m["model"]
                ] += 1
            if m.get("stopReason"):
                c.stops[m["stopReason"]] += 1
            u = m.get("usage") or {}
            c.usage(
                u.get("input") or 0,
                u.get("output") or 0,
                u.get("cacheRead") or 0,
                u.get("cacheWrite") or 0,
                u.get("reasoning") or 0,
                (u.get("cost") or {}).get("total") or 0.0,
            )
            blocks = m.get("content") if isinstance(m.get("content"), list) else []
            thinking = [b for b in blocks if b.get("type") == "thinking"]
            if thinking:
                s.reasoning_steps += 1
                s.reasoning_chars += sum(len(b.get("thinking") or "") for b in thinking)
            calls = [b for b in blocks if b.get("type") == "toolCall"]
            s.steps_with_tools += bool(calls)
            s.steps_without_tools += not calls
            for b in calls:
                args = b.get("arguments") or {}
                name = b.get("name") or "?"
                tc = ToolCall(
                    name=name,
                    command=args.get("command") if name == "bash" else None,
                    path=args.get("path"),
                    action=PI_PATH_TOOLS.get(name, "other"),  # type: ignore[arg-type]
                )
                c.calls.append(tc)
                if b.get("id"):
                    pending[b["id"]] = tc
            text = "".join(
                b.get("text") or "" for b in blocks if b.get("type") == "text"
            )
            if text.strip():
                s.final_message = text
        elif role == "toolResult":
            tc = pending.get(m.get("toolCallId") or "")
            if tc and m.get("isError"):
                tc.error = True
    return c.finish(top)


CLAUDE_PATH_TOOLS = {
    "Read": "read",
    "Edit": "edit",
    "MultiEdit": "edit",
    "NotebookEdit": "edit",
    "Write": "write",
}


def parse_claude(path: Path, top: int) -> Summary:
    c = Collector(path, "claude")
    s = c.s
    s.agent = "claude-code"
    pending: dict[str, ToolCall] = {}
    seen_msgs: set[str] = set()
    tool_msgs: set[str] = set()
    stops: dict[str, str] = {}
    for line in path.read_text().splitlines():
        if not line.strip():
            continue
        e = json.loads(line)
        c.when(e.get("timestamp"))
        s.session_id = s.session_id or e.get("sessionId")
        s.cwd = s.cwd or e.get("cwd")
        if e.get("isSidechain"):
            continue
        m = e.get("message") or {}
        if e.get("type") == "user":
            content = m.get("content")
            if (
                isinstance(content, str)
                or not any(
                    isinstance(b, dict) and b.get("type") == "tool_result"
                    for b in content or []
                )
            ) and not e.get("isMeta"):
                s.user_messages += 1
            for b in content if isinstance(content, list) else []:
                if (
                    isinstance(b, dict)
                    and b.get("type") == "tool_result"
                    and b.get("is_error")
                ):
                    tc = pending.get(b.get("tool_use_id") or "")
                    if tc:
                        tc.error = True
        elif e.get("type") == "assistant":
            # one API response is split across several lines sharing message.id
            mid = m.get("id") or e.get("uuid")
            first = mid not in seen_msgs
            seen_msgs.add(mid)
            if first:
                s.agent_steps += 1
                if m.get("model") and m["model"] != "<synthetic>":
                    c.models[m["model"]] += 1
                u = m.get("usage") or {}
                c.usage(
                    u.get("input_tokens") or 0,
                    u.get("output_tokens") or 0,
                    u.get("cache_read_input_tokens") or 0,
                    u.get("cache_creation_input_tokens") or 0,
                )
            if m.get("stop_reason"):
                stops[mid] = m[
                    "stop_reason"
                ]  # streamed lines repeat it; keep one per response
            for b in m.get("content") or []:
                if b.get("type") == "thinking":
                    s.reasoning_steps += first
                    s.reasoning_chars += len(b.get("thinking") or "")
                elif b.get("type") == "text" and (b.get("text") or "").strip():
                    s.final_message = b["text"]
                elif b.get("type") == "tool_use":
                    inp = b.get("input") or {}
                    name = b.get("name") or "?"
                    tc = ToolCall(
                        name=name,
                        command=inp.get("command") if name == "Bash" else None,
                        path=inp.get("file_path") or inp.get("notebook_path"),
                        action=CLAUDE_PATH_TOOLS.get(name, "other"),  # type: ignore[arg-type]
                    )
                    c.calls.append(tc)
                    pending[b.get("id") or ""] = tc
                    tool_msgs.add(mid)
    s.steps_with_tools = len(tool_msgs)
    c.stops.update(stops.values())
    s.steps_without_tools = max(0, s.agent_steps - s.steps_with_tools)
    return c.finish(top)


# Cortex (Windsurf / Antigravity). Tool and arg names as used by those agents;
# exports may keep enum prefixes (CORTEX_STEP_TYPE_...) or strip them.
CORTEX_PREFIXES = (
    "CORTEX_STEP_TYPE_",
    "CORTEX_STEP_SOURCE_",
    "CORTEX_STEP_STATUS_",
    "STEP_TYPE_",
    "STEP_STATUS_",
)
CORTEX_READ = {
    "view_file",
    "view_file_outline",
    "view_code_item",
    "read_file",
    "view_content_chunk",
}
CORTEX_EDIT = {
    "replace_file_content",
    "multi_replace_file_content",
    "edit_file",
    "propose_code",
    "apply_edit",
}
CORTEX_WRITE = {"write_to_file", "create_file"}
CORTEX_PATH_ARGS = (
    "TargetFile",
    "AbsolutePath",
    "FilePath",
    "File",
    "Path",
    "file_path",
    "path",
)
CORTEX_CMD_ARGS = ("CommandLine", "Command", "command", "command_line")
CORTEX_FAIL = {
    "ERROR",
    "FAILED",
    "FAILURE",
    "CANCELED",
    "CANCELLED",
    "INTERRUPTED",
    "HALTED",
    "TIMEOUT",
}
# step types that are the result of a tool, keyed to the tool that produced them
CORTEX_RESULT_TOOL = {
    "RUN_COMMAND": "run_command",
    "COMMAND_STATUS": "command_status",
    "VIEW_FILE": "view_file",
    "VIEW_FILE_OUTLINE": "view_file_outline",
    "VIEW_CODE_ITEM": "view_code_item",
    "CODE_ACTION": "replace_file_content",
    "WRITE_TO_FILE": "write_to_file",
    "GREP_SEARCH": "grep_search",
    "FIND": "find_by_name",
    "LIST_DIRECTORY": "list_dir",
    "READ_URL_CONTENT": "read_url_content",
    "SEARCH_WEB": "search_web",
}


def cortex_norm(value: Any) -> str:
    v = str(value or "").upper()
    for prefix in CORTEX_PREFIXES:
        if v.startswith(prefix):
            return v[len(prefix) :]
    return v


def cortex_steps(doc: Any) -> list[dict[str, Any]] | None:
    """Find the step array anywhere in the document (breadth-first)."""
    queue: list[Any] = [doc]
    while queue:
        node = queue.pop(0)
        if isinstance(node, list):
            dicts = [x for x in node if isinstance(x, dict)]
            if (
                dicts
                and sum(
                    "type" in d and ("step_index" in d or "source" in d) for d in dicts
                )
                >= len(dicts) / 2
            ):
                return dicts
            queue.extend(x for x in node if isinstance(x, (dict, list)))
        elif isinstance(node, dict):
            queue.extend(v for v in node.values() if isinstance(v, (dict, list)))
    return None


def first_key(d: dict[str, Any], keys: tuple[str, ...]) -> Any:
    for k in keys:
        if d.get(k) not in (None, ""):
            return d[k]
    return None


def num(d: dict[str, Any], *keys: str) -> int:
    v = first_key(d, keys)
    try:
        return int(v or 0)
    except (TypeError, ValueError):
        return 0


def parse_cortex(path: Path, top: int) -> Summary:
    doc = json.loads(path.read_text())
    steps = cortex_steps(doc) or []
    c = Collector(path, "cortex")
    s = c.s
    s.agent = "cortex"
    if isinstance(doc, dict):
        s.session_id = first_key(
            doc,
            (
                "trajectory_id",
                "trajectoryId",
                "cascade_id",
                "cascadeId",
                "conversation_id",
                "id",
            ),
        )
        model = first_key(doc, ("model", "model_name", "modelName"))
        if isinstance(model, str):
            c.models[model] += 0
        s.cwd = first_key(doc, ("workspace", "cwd", "workspace_path", "workspacePath"))
    types: Counter[str] = Counter()
    statuses: Counter[str] = Counter()
    open_calls: dict[
        str, list[ToolCall]
    ] = {}  # tool name -> calls awaiting a result step
    for step in sorted(
        steps,
        key=lambda d: (
            d.get("step_index", 0) if isinstance(d.get("step_index"), int) else 0
        ),
    ):
        c.when(
            first_key(step, ("created_at", "createdAt", "timestamp", "completed_at"))
        )
        kind = cortex_norm(step.get("type"))
        status = cortex_norm(step.get("status")) or "DONE"
        source = cortex_norm(step.get("source"))
        types[kind] += 1
        if status != "DONE":
            statuses[status] += 1
        failed = status in CORTEX_FAIL or bool(step.get("error"))
        if (
            kind == "USER_INPUT"
            or source.startswith("USER")
            and kind != "PLANNER_RESPONSE"
        ):
            s.user_messages += kind == "USER_INPUT" or source.startswith("USER")
            continue
        if kind == "PLANNER_RESPONSE" or (source == "MODEL" and "tool_calls" in step):
            s.agent_steps += 1
            model = first_key(step, ("model", "model_name", "modelName"))
            if isinstance(model, str):
                c.models[model] += 1
            c.usage(
                num(step, "input_tokens", "inputTokens", "prompt_tokens"),
                num(step, "output_tokens", "outputTokens", "completion_tokens"),
                num(step, "cache_read_tokens", "cacheReadTokens", "cached_tokens"),
                num(
                    step,
                    "cache_write_tokens",
                    "cacheWriteTokens",
                    "cache_creation_tokens",
                ),
                num(step, "thinking_tokens", "reasoning_tokens", "thinkingTokens"),
            )
            thinking = first_key(
                step, ("thinking", "reasoning", "thinking_content", "reasoning_content")
            )
            if thinking:
                s.reasoning_steps += 1
                s.reasoning_chars += len(text_of(thinking))
            text = first_key(step, ("content", "response", "text", "message"))
            if text and text_of(text).strip():
                s.final_message = text_of(text)
            if step.get("stop_reason") or step.get("stopReason"):
                c.stops[str(step.get("stop_reason") or step.get("stopReason"))] += 1
            calls = step.get("tool_calls") or step.get("toolCalls") or []
            s.steps_with_tools += bool(calls)
            s.steps_without_tools += not calls
            for call in calls:
                name = str(call.get("name") or call.get("function_name") or "?")
                args = (
                    call.get("args") or call.get("arguments") or call.get("input") or {}
                )
                if isinstance(args, str):
                    try:
                        args = json.loads(args)
                    except json.JSONDecodeError:
                        args = {}
                cmd = (
                    first_key(args, CORTEX_CMD_ARGS)
                    if name in ("run_command", "send_command_input")
                    else None
                )
                action = (
                    "read" if name in CORTEX_READ
                    else "edit" if name in CORTEX_EDIT
                    else "write" if name in CORTEX_WRITE
                    else "other"
                )  # fmt: skip
                p = first_key(args, CORTEX_PATH_ARGS) if action != "other" else None
                tc = ToolCall(
                    name=name,
                    command=cmd if isinstance(cmd, str) else None,
                    path=p,
                    action=action,
                    error=failed,
                )  # type: ignore[arg-type]
                c.calls.append(tc)
                open_calls.setdefault(name, []).append(tc)
            continue
        # anything else is a tool-result / system step: pair failures with the call
        tool = CORTEX_RESULT_TOOL.get(kind, kind.lower())
        exit_code = first_key(step, ("exit_code", "exitCode"))
        if isinstance(exit_code, int) and exit_code != 0:
            failed = True
        pending = open_calls.get(tool) or []
        if pending:
            tc = pending.pop(0)
            tc.error = tc.error or failed
    s.step_types = dict(types.most_common())
    s.step_statuses = dict(statuses.most_common())
    return c.finish(top)


# ---------------------------------------------------------------- patches


PATCH_FILE = re.compile(r"^\*\*\* (Add|Update|Delete) File: (.+?)\s*$", re.MULTILINE)
PATCH_MOVE = re.compile(r"^\*\*\* Move to: (.+?)\s*$", re.MULTILINE)


def patch_files(text: str) -> list[tuple[str, str]]:
    """(action, path) pairs from an apply_patch envelope (Codex / OpenCode)."""
    out = [
        ({"Add": "write", "Update": "edit", "Delete": "delete"}[m.group(1)], m.group(2))
        for m in PATCH_FILE.finditer(text)
    ]
    out += [("write", m.group(1)) for m in PATCH_MOVE.finditer(text)]
    return out


def add_patch_calls(c: Collector, name: str, text: str, error: bool) -> list[ToolCall]:
    """One ToolCall per file in a patch; deletions go to the shell-deleted list."""
    calls: list[ToolCall] = []
    files = patch_files(text)
    for action, path in files:
        if action == "delete":
            c.patch_deleted.append(path)
            continue
        calls.append(ToolCall(name=name, path=path, action=action, error=error))  # type: ignore[arg-type]
    if not calls:
        calls.append(ToolCall(name=name, error=error))
    c.calls.extend(calls[:1])
    for extra in calls[1:]:  # same call touching more files: keep counts honest
        c.extra_paths.append(extra)
    return calls


# ---------------------------------------------------------------- codex

EXIT_LINE = re.compile(r"(?:Process exited with code|Exit code:?)\s*(-?\d+)")


def codex_exit(output: Any) -> int | None:
    if isinstance(output, str):
        try:
            obj = json.loads(output)
        except json.JSONDecodeError:
            obj = None
        if isinstance(obj, dict):
            meta = obj.get("metadata") or {}
            if isinstance(meta.get("exit_code"), int):
                return meta["exit_code"]
            output = obj.get("output") or ""
        m = EXIT_LINE.search(output if isinstance(output, str) else "")
        return int(m.group(1)) if m else None
    return None


def parse_codex(path: Path, top: int) -> Summary:
    c = Collector(path, "codex")
    s = c.s
    pending: dict[str, list[ToolCall]] = {}
    last_total: tuple[int, ...] | None = None
    calls_at_last_step = 0  # tool calls precede the token_count that closes a response
    for line in path.read_text().splitlines():
        if not line.strip():
            continue
        e = json.loads(line)
        c.when(e.get("timestamp"))
        kind, p = e.get("type"), e.get("payload") or {}
        if kind == "session_meta":
            s.session_id, s.cwd = p.get("id"), p.get("cwd")
            s.agent = " ".join(x for x in ("codex", p.get("cli_version")) if x)
            continue
        if kind == "turn_context":
            if p.get("model"):
                c.models[p["model"]] += 0
            s.cwd = s.cwd or p.get("cwd")
            continue
        ptype = p.get("type")
        if kind == "event_msg":
            if ptype == "user_message":
                s.user_messages += 1
            elif ptype == "agent_message" and p.get("message"):
                s.final_message = p["message"]
            elif ptype == "token_count" and p.get("info"):
                info = p["info"]
                total = info.get("total_token_usage") or {}
                key = tuple(
                    total.get(k) or 0
                    for k in ("input_tokens", "cached_input_tokens", "output_tokens")
                )
                if key == last_total:  # codex re-emits the same count; one per response
                    continue
                last_total = key
                u = info.get("last_token_usage") or {}
                s.agent_steps += 1
                made = len(c.calls) > calls_at_last_step
                s.steps_with_tools += made
                s.steps_without_tools += not made
                calls_at_last_step = len(c.calls)
                cached = u.get("cached_input_tokens") or 0
                # OpenAI style: input_tokens includes the cached part
                c.usage(
                    (u.get("input_tokens") or 0) - cached,
                    u.get("output_tokens") or 0,
                    cached,
                    0,
                    u.get("reasoning_output_tokens") or 0,
                )
            continue
        if kind != "response_item":
            continue
        if ptype == "reasoning":
            s.reasoning_steps += 1
            s.reasoning_chars += sum(
                len(x.get("text") or "")
                for x in p.get("summary") or []
                if isinstance(x, dict)
            )
        elif ptype in ("function_call", "local_shell_call"):
            name = p.get("name") or ptype
            args: Any = p.get("arguments") or p.get("action") or {}
            if isinstance(args, str):
                try:
                    args = json.loads(args)
                except json.JSONDecodeError:
                    args = {}
            cmd = (
                args.get("cmd") or args.get("command")
                if isinstance(args, dict)
                else None
            )
            if isinstance(cmd, list):  # ["bash", "-lc", "..."]
                cmd = (
                    cmd[-1]
                    if len(cmd) >= 3 and cmd[1] in ("-lc", "-c")
                    else shlex.join(cmd)
                )
            tc = ToolCall(name=name, command=cmd if isinstance(cmd, str) else None)
            c.calls.append(tc)
            pending.setdefault(p.get("call_id") or "", []).append(tc)
        elif ptype == "custom_tool_call":
            name = p.get("name") or "custom"
            if name == "apply_patch":
                calls = add_patch_calls(c, name, p.get("input") or "", False)
            else:
                calls = [ToolCall(name=name)]
                c.calls.extend(calls)
            pending.setdefault(p.get("call_id") or "", []).extend(calls)
        elif ptype in (
            "function_call_output",
            "custom_tool_call_output",
            "local_shell_call_output",
        ):
            code = codex_exit(p.get("output"))
            if code not in (None, 0):
                for tc in pending.get(p.get("call_id") or "", []):
                    tc.error = True
    return c.finish(top)


# ---------------------------------------------------------------- opencode

OC_READ, OC_EDIT, OC_WRITE = {"read"}, {"edit", "multiedit"}, {"write"}
OC_SHELL = {"bash", "shell"}
OC_PATCH = {"patch", "apply_patch"}


def opencode_summary(
    path: Path, label: str, info: dict[str, Any], msgs: list[dict[str, Any]], top: int
) -> Summary:
    """msgs: normalized [{role, time, tokens, cost, finish, model, parts:[{type,text,name,status,input,exit,error}]}]"""
    c = Collector(path, "opencode")
    s = c.s
    s.file = label
    s.session_id = info.get("id")
    s.cwd = info.get("directory")
    s.agent = "opencode" + (" (subagent)" if info.get("parent_id") else "")
    for m in msgs:
        c.when(m.get("time"))
        role = m.get("role")
        if role == "user":
            s.user_messages += 1
            continue
        if role != "assistant":
            continue
        s.agent_steps += 1
        if m.get("error"):  # provider/API failure on this response
            key = f"error:{m['error']}"
            s.step_statuses[key] = s.step_statuses.get(key, 0) + 1
        if m.get("model"):
            c.models[m["model"]] += 1
        if m.get("finish"):
            c.stops[m["finish"]] += 1
        t = m.get("tokens") or {}
        cache = t.get("cache") or {}
        c.usage(
            t.get("input") or 0,
            t.get("output") or 0,
            cache.get("read") or 0,
            cache.get("write") or 0,
            t.get("reasoning") or 0,
            m.get("cost") or 0.0,
        )
        tools = 0
        for part in m.get("parts") or []:
            ptype = part.get("type")
            if ptype == "reasoning" and part.get("text"):
                s.reasoning_steps += 1
                s.reasoning_chars += len(part["text"])
            elif ptype == "text" and (part.get("text") or "").strip():
                s.final_message = part["text"]
            elif ptype == "tool":
                tools += 1
                name = part.get("name") or "?"
                inp = part.get("input") or {}
                err = part.get("status") == "error" or (
                    isinstance(part.get("exit"), int) and part["exit"] != 0
                )
                if name in OC_PATCH:
                    add_patch_calls(
                        c,
                        name,
                        inp.get("patchText")
                        or inp.get("patch")
                        or inp.get("input")
                        or "",
                        err,
                    )
                    continue
                action = (
                    "read"
                    if name in OC_READ
                    else "edit"
                    if name in OC_EDIT
                    else "write"
                    if name in OC_WRITE
                    else "other"
                )
                c.calls.append(
                    ToolCall(
                        name=name,
                        command=inp.get("command") if name in OC_SHELL else None,
                        path=(inp.get("filePath") or inp.get("path"))
                        if action != "other"
                        else None,
                        action=action,  # type: ignore[arg-type]
                        error=err,
                    )
                )
        s.steps_with_tools += bool(tools)
        s.steps_without_tools += not tools
    return c.finish(top)


def oc_part(d: dict[str, Any]) -> dict[str, Any]:
    st = d.get("state") or {}
    meta = st.get("metadata") or {}
    return {
        "type": d.get("type"),
        "text": d.get("text"),
        "name": d.get("tool") or d.get("name"),
        "status": st.get("status"),
        "input": st.get("input") or {},
        "exit": meta.get("exit", meta.get("exit_code")),
    }


def parse_opencode(path: Path, top: int) -> Summary:
    """`opencode session export` JSON (v2 shape; v1 info/parts shape also accepted)."""
    doc = json.loads(path.read_text())
    info = doc.get("info") or {}
    norm_info = {
        "id": info.get("id"),
        "directory": (info.get("location") or {}).get("directory")
        or info.get("directory"),
        "parent_id": info.get("parentID"),
    }
    msgs: list[dict[str, Any]] = []
    for m in doc.get("messages") or []:
        mi = m.get("info") or m  # v1: {info, parts}; v2: flat
        role = mi.get("role") or mi.get("type")
        model = mi.get("model")
        if isinstance(model, dict):
            model = "/".join(x for x in (model.get("providerID"), model.get("id")) if x)
        elif mi.get("modelID"):
            model = "/".join(x for x in (mi.get("providerID"), mi.get("modelID")) if x)
        parts = (
            m.get("parts")
            if "parts" in m
            else m.get("content")
            if isinstance(m.get("content"), list)
            else []
        )
        msgs.append(
            {
                "role": role,
                "time": (mi.get("time") or {}).get("created"),
                "tokens": mi.get("tokens"),
                "cost": mi.get("cost"),
                "finish": mi.get("finish"),
                "error": (mi.get("error") or {}).get("name")
                if isinstance(mi.get("error"), dict)
                else mi.get("error"),
                "model": model,
                "parts": [oc_part(x) for x in parts or [] if isinstance(x, dict)],
            }
        )
    return opencode_summary(path, str(path), norm_info, msgs, top)


def parse_opencode_db(
    path: Path, top: int, session: str | None = None
) -> list[Summary]:
    try:
        db = sqlite3.connect(f"file:{path}?mode=ro", uri=True)
        db.execute("select 1 from session limit 1")
    except sqlite3.Error:
        db = sqlite3.connect(f"file:{path}?immutable=1", uri=True)
    db.row_factory = sqlite3.Row
    q = "select id, directory, title, parent_id from session"
    args: list[str] = []
    if session:
        q += " where id like ? or title like ?"
        args = [f"%{session}%", f"%{session}%"]
    q += " order by time_created"
    out: list[Summary] = []
    for row in db.execute(q, args).fetchall():
        parts: dict[str, list[dict[str, Any]]] = {}
        for pr in db.execute(
            "select message_id, data from part where session_id = ? order by id",
            (row["id"],),
        ):
            parts.setdefault(pr["message_id"], []).append(
                oc_part(json.loads(pr["data"]))
            )
        msgs = []
        for mr in db.execute(
            "select id, data from message where session_id = ? order by time_created, id",
            (row["id"],),
        ):
            d = json.loads(mr["data"])
            model = (
                "/".join(x for x in (d.get("providerID"), d.get("modelID")) if x)
                or None
            )
            msgs.append(
                {
                    "role": d.get("role"),
                    "time": (d.get("time") or {}).get("created"),
                    "tokens": d.get("tokens"),
                    "cost": d.get("cost"),
                    "finish": d.get("finish"),
                    "error": (d.get("error") or {}).get("name")
                    if isinstance(d.get("error"), dict)
                    else d.get("error"),
                    "model": model,
                    "parts": parts.get(mr["id"], []),
                }
            )
        label = f"{path}#{row['id']}"
        s = opencode_summary(path, label, dict(row), msgs, top)
        out.append(s)
    db.close()
    return out


# ---------------------------------------------------------------- discovery


def detect(path: Path) -> Format | None:
    try:
        with path.open("rb") as fb:
            magic = fb.read(16)
    except OSError:
        return None
    if magic.startswith(b"SQLite format 3"):
        try:
            db = sqlite3.connect(f"file:{path}?mode=ro", uri=True)
            names = {
                r[0]
                for r in db.execute("select name from sqlite_master where type='table'")
            }
            db.close()
        except sqlite3.Error:
            return None
        return "opencode-db" if {"session", "message", "part"} <= names else None
    try:
        with path.open() as f:
            head = f.read(4096)
    except (OSError, UnicodeDecodeError):
        return None
    if path.suffix == ".json":
        if '"schema_version"' in head and "ATIF" in head:
            return "atif"
        if '"info"' in head and '"messages"' in head and '"ses_' in head:
            return "opencode"
        if (
            '"step_index"' in head
            or "PLANNER_RESPONSE" in head
            or "CORTEX_STEP" in head
        ):
            return "cortex"
        return None
    try:
        with path.open() as f:
            first = f.readline(4_000_000)  # codex puts ~12 KB of instructions on line 1
    except (OSError, UnicodeDecodeError):
        return None
    try:
        obj = json.loads(first)
    except json.JSONDecodeError:
        return None
    if obj.get("type") == "session" and "version" in obj:
        return "pi"
    if obj.get("type") == "session_meta" or (
        obj.get("type") == "response_item" and "payload" in obj
    ):
        return "codex"
    if "sessionId" in obj or obj.get("type") in (
        "user",
        "assistant",
        "summary",
        "file-history-snapshot",
    ):
        return "claude"
    return None


def expand(paths: list[Path]) -> list[tuple[Path, Format]]:
    out: list[tuple[Path, Format]] = []
    for p in paths:
        candidates = (
            sorted(p.rglob("*.json"))
            + sorted(p.rglob("*.jsonl"))
            + sorted(p.rglob("opencode*.db"))
            if p.is_dir()
            else [p]
        )
        for f in candidates:
            fmt = detect(f)
            if fmt:
                out.append((f, fmt))
            elif not p.is_dir():
                print(f"trajsum: {f}: unrecognized format", file=sys.stderr)
    return out


PARSERS = {
    "atif": parse_atif,
    "pi": parse_pi,
    "claude": parse_claude,
    "cortex": parse_cortex,
    "codex": parse_codex,
    "opencode": parse_opencode,
}


# ---------------------------------------------------------------- output


def human(n: float) -> str:
    for unit in ("", "K", "M", "B"):
        if abs(n) < 1000:
            return f"{n:.0f}{unit}" if unit == "" else f"{n:.1f}{unit}"
        n /= 1000
    return f"{n:.1f}T"


def dur(seconds: float | None) -> str:
    if seconds is None:
        return "?"
    m, sec = divmod(int(seconds), 60)
    h, m = divmod(m, 60)
    return f"{h}h{m:02d}m" if h else f"{m}m{sec:02d}s"


def show_detail(s: Summary, top: int) -> None:
    t = s.tokens
    print(f"━━ {s.file}")
    print(
        f"  format      {s.format}  agent={s.agent or '?'}  session={s.session_id or '?'}"
    )
    print(f"  models      {', '.join(s.models) or '?'}")
    if s.cwd:
        print(f"  cwd/task    {s.cwd}")
    busy = s.active_s is not None and s.active_s < (s.duration_s or 0) * 0.9
    active = f", {dur(s.active_s)} active" if busy else ""
    print(
        f"  time        {s.started or '?'} → {s.ended or '?'}  ({dur(s.duration_s)}{active})"
    )
    if s.reward is not None or s.exception:
        print(f"  outcome     reward={s.reward}  exception={s.exception or '-'}")
    print(
        f"  steps       {s.agent_steps} agent ({s.steps_with_tools} with tools, {s.steps_without_tools} without)"
        f"  ·  {s.user_messages} user"
        + (f"  ·  {s.branches} abandoned branches" if s.branches else "")
    )
    if s.reasoning_steps:
        chars = (
            f"{human(s.reasoning_chars)} chars"
            if s.reasoning_chars
            else "content redacted"
        )
        print(f"  reasoning   {s.reasoning_steps} steps, {chars}")
    if s.step_types:
        print("  step types  " + ", ".join(f"{k} {v}" for k, v in s.step_types.items()))
    if s.step_statuses:
        print(
            "  failures    " + ", ".join(f"{k} {v}" for k, v in s.step_statuses.items())
        )
    print(
        f"  tool calls  {s.tool_calls}: "
        + ", ".join(f"{k} {v}" for k, v in s.tools.items())
    )
    if s.tool_errors:
        print(
            f"  tool errors {s.tool_errors}: "
            + ", ".join(f"{k} {v}" for k, v in s.tool_errors_by_tool.items())
        )
    if s.parse_errors:
        print(
            f"  parse errs  {s.parse_errors}: "
            + "; ".join(f"{k} ×{v}" for k, v in s.parse_error_kinds.items())
        )
    if s.stop_reasons:
        print(
            "  stops       " + ", ".join(f"{k} {v}" for k, v in s.stop_reasons.items())
        )
    print(
        f"  tokens      in {human(t.input)}  out {human(t.output)}  cache r/w {human(t.cache_read)}/{human(t.cache_write)}"
        f"  peak ctx {human(t.peak_context)}"
        + (f"  reasoning {human(t.reasoning)}" if t.reasoning else "")
        + (f"  ${t.cost_usd:.2f}" if t.cost_usd else "")
    )
    failed = f", {s.failed_commands} failed" if s.failed_commands else ""
    print(
        f"  commands    {s.commands} ({s.unique_commands} unique{failed}); by program: "
        + ", ".join(f"{k} {v}" for k, v in s.command_heads.items())
    )
    for cmd in s.top_commands:
        print(f"      $ {cmd}")
    if s.commands > len(s.top_commands):
        print(f"      … {s.commands - len(s.top_commands)} more (--top N)")

    def files(label: str, items: list[str]) -> None:
        if not items:
            return
        shown = ", ".join(items[:top]) + (
            f", … +{len(items) - top}" if len(items) > top else ""
        )
        print(f"  {label:<11} {len(items)}: {shown}")

    files("edited", s.files_edited)
    if s.edit_ops > len(s.files_edited):
        print(f"              ({s.edit_ops} edit calls)")
    files("written", s.files_written)
    files("deleted", s.files_deleted)
    files("sh-written", s.files_shell_written)
    files("sh-deleted", s.files_shell_deleted)
    files("read", s.files_read)
    if s.final_message:
        msg = " ".join(s.final_message.split())
        print(f"  last msg    {msg[:300]}{'…' if len(msg) > 300 else ''}")
    print()


def show_table(rows: list[Summary]) -> None:
    hdr = f"{'run':38} {'fmt':6} {'steps':>5} {'tools':>5} {'cmds':>5} {'err':>4} {'perr':>4} {'edit':>4} {'wrt':>4} {'in':>7} {'out':>6} {'peak':>6} {'time':>7} {'rwd':>4}"
    print(hdr)
    print("─" * len(hdr))
    for s in rows:
        p = Path(s.file)
        if "#" in s.file:  # opencode.db#<session id>
            name = s.file.rsplit("#", 1)[1]
        elif p.name == "trajectory.json":
            name = p.parent.parent.name
        else:
            name = p.stem
        name = name if len(name) <= 38 else name[:37] + "…"
        files_w = len(s.files_written) + len(s.files_shell_written)
        rwd = "" if s.reward is None else f"{s.reward:g}"
        print(
            f"{name:38} {s.format:6} {s.agent_steps:>5} {s.tool_calls:>5} {s.commands:>5} {s.tool_errors:>4} {s.parse_errors:>4}"
            f" {len(s.files_edited):>4} {files_w:>4} {human(s.tokens.input):>7} {human(s.tokens.output):>6}"
            f" {human(s.tokens.peak_context):>6} {dur(s.active_s if s.active_s is not None else s.duration_s):>7} {rwd:>4}"
        )
    tot = lambda f: sum(f(s) for s in rows)
    rewards = [s.reward for s in rows if s.reward is not None]
    print("─" * len(hdr))
    print(
        f"{len(rows)} runs · {tot(lambda s: s.agent_steps)} steps · {tot(lambda s: s.tool_calls)} tool calls"
        f" · {tot(lambda s: s.commands)} commands · {tot(lambda s: s.tool_errors)} tool errors"
        f" · {tot(lambda s: s.parse_errors)} parse errors · in {human(tot(lambda s: s.tokens.input))}"
        f" out {human(tot(lambda s: s.tokens.output))}"
        + (f" · pass {sum(r >= 1 for r in rewards)}/{len(rewards)}" if rewards else "")
    )
    print(
        "columns: err=tool errors, perr=response parse errors, edit=files edited, wrt=files written (tool + shell-inferred), time=active (idle gaps >5m dropped)"
    )


def main() -> int:
    ap = argparse.ArgumentParser(
        prog="trajsum",
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    ap.add_argument("paths", nargs="+", type=Path)
    ap.add_argument(
        "--json", action="store_true", help="JSON lines, one summary per run"
    )
    ap.add_argument("--detail", action="store_true", help="full summary for every run")
    ap.add_argument(
        "--top",
        type=int,
        default=10,
        help="list length for commands/files (default 10)",
    )
    ap.add_argument(
        "--format",
        choices=[*PARSERS, "opencode-db"],
        help="force a format instead of detecting",
    )
    ap.add_argument(
        "--session",
        help="opencode.db: only sessions whose id or title contains this",
    )
    a = ap.parse_args()

    found = [(p, a.format) for p in a.paths] if a.format else expand(a.paths)
    if not found:
        print("trajsum: no trajectories or sessions found", file=sys.stderr)
        return 1
    rows: list[Summary] = []
    for path, fmt in found:
        try:
            if fmt == "opencode-db":
                rows.extend(parse_opencode_db(path, a.top, a.session))
            else:
                rows.append(PARSERS[fmt](path, a.top))  # type: ignore[index]
        except (
            json.JSONDecodeError,
            KeyError,
            TypeError,
            AttributeError,
            sqlite3.Error,
        ) as exc:
            print(f"trajsum: {path}: {type(exc).__name__}: {exc}", file=sys.stderr)
    if a.json:
        for s in rows:
            print(s.model_dump_json())
    elif len(rows) == 1 or a.detail:
        for s in rows:
            show_detail(s, a.top)
    else:
        show_table(rows)
    return 0


if __name__ == "__main__":
    sys.exit(main())
