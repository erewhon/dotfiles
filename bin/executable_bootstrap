#!/usr/bin/env bash
# bootstrap — set up a new Linux machine with dotfiles.
# Installs prerequisites, Linuxbrew, chezmoi, and applies dotfiles.
# Idempotent — safe to re-run if something fails partway through.
#
# Usage (on a fresh machine):
#   bash <(curl -fsSL https://raw.githubusercontent.com/erewhon/dotfiles/main/bin/executable_bootstrap) [--home|--work]
# Or if already cloned:
#   bash bin/executable_bootstrap [--home|--work]
#
# Options:
#   --home   Mark this machine as a home/personal node (home LLM router, Forge,
#            `ho secret`, personal skills and packages). Persisted in
#            ~/.config/chezmoi/chezmoi.toml, so `chezmoi update` keeps it.
#   --work   Explicitly mark it as NOT a home node.
#   --desktop  Mark this machine as one you sit at (terminal emulators,
#            sketchybar, KDE/Krohnkite setup). Use this for a work laptop
#            instead of adding its hostname to the public catalog.
#   --remote Explicitly mark it as ssh-only (no desktop configs).
#   (neither) A host listed in .chezmoidata.toml keeps its catalog value;
#            an unknown host is asked interactively, defaulting to work and
#            to remote (on Linux) / desktop (on macOS).
#
# Re-running with these flags on an already bootstrapped machine flips the
# stored answers (it re-renders the chezmoi config; nothing else is re-done).

set -euo pipefail

# ---------------------------------------------------------------------------
# Arguments
# ---------------------------------------------------------------------------
HOME_NODE=""   # "", "true" or "false"
REMOTE_NODE="" # "", "true" or "false"
for arg in "$@"; do
    case "$arg" in
        --home|--personal) HOME_NODE="true" ;;
        --work|--not-home) HOME_NODE="false" ;;
        --desktop) REMOTE_NODE="false" ;;
        --remote) REMOTE_NODE="true" ;;
        -h|--help)
            sed -n '2,/^set -euo/p' "$0" | sed '$d' | sed 's/^# \{0,1\}//'
            exit 0 ;;
        *) echo "error: unknown option: $arg (try --help)" >&2; exit 2 ;;
    esac
done

# Answers for the prompts in .chezmoi.toml.tmpl. --promptBool is keyed by the
# prompt text ("home", "remote"), and --prompt is what lets a new answer
# replace a persisted one on re-run.
CHEZMOI_INIT_ARGS=()
if [[ -n "$HOME_NODE" || -n "$REMOTE_NODE" ]]; then
    # --prompt re-asks every *Once prompt; --promptDefaults answers the ones
    # not given here with their default, which the template sets to the
    # already-stored value. So flipping one answer leaves the other alone.
    CHEZMOI_INIT_ARGS+=(--prompt --promptDefaults)
    [[ -n "$HOME_NODE" ]] && CHEZMOI_INIT_ARGS+=(--promptBool "home=${HOME_NODE}")
    [[ -n "$REMOTE_NODE" ]] && CHEZMOI_INIT_ARGS+=(--promptBool "remote=${REMOTE_NODE}")
elif [[ ! -t 0 ]]; then
    # No terminal to ask on: take the catalog value / work default rather
    # than letting chezmoi read the answer from whatever stdin is.
    CHEZMOI_INIT_ARGS+=(--promptDefaults)
fi

# ---------------------------------------------------------------------------
# Color / formatting
# ---------------------------------------------------------------------------
if [ -t 1 ]; then
    BOLD=$'\033[1m'    GREEN=$'\033[32m'    RED=$'\033[31m'
    DIM=$'\033[2m'     RESET=$'\033[0m'
else
    BOLD=""  GREEN=""  RED=""  DIM=""  RESET=""
fi

STEP=0
TOTAL=7

step() {
    STEP=$((STEP + 1))
    printf "  ${BOLD}[%d/%d]${RESET} %-40s" "$STEP" "$TOTAL" "$1"
}

done_msg()    { printf "${GREEN}done${RESET}\n"; }
skip_msg()    { printf "${DIM}done (already installed)${RESET}\n"; }
skipped_msg() { printf "${DIM}skipped${RESET}\n"; }

# ---------------------------------------------------------------------------
# Pre-flight checks
# ---------------------------------------------------------------------------
if [[ "$(uname)" == "Darwin" ]]; then
    echo "This script is for Linux. On macOS:"
    echo "  1. Install Homebrew: /bin/bash -c \"\$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)\""
    echo "  2. brew install chezmoi"
    echo "  3. chezmoi init erewhon/dotfiles --apply"
    exit 1
fi

PKG_MGR=""
if command -v apt-get &>/dev/null; then
    PKG_MGR="apt"
elif command -v dnf &>/dev/null; then
    PKG_MGR="dnf"
else
    echo "error: neither apt-get nor dnf found. This script requires Debian/Ubuntu or Fedora." >&2
    exit 1
fi

echo
echo "${BOLD}bootstrap${RESET} — setting up dotfiles on a new machine"
echo

# ---------------------------------------------------------------------------
# 1. System packages
# ---------------------------------------------------------------------------
step "System packages (${PKG_MGR})..."

if [[ "$PKG_MGR" == "apt" ]]; then
    NEEDED=()
    for pkg in git curl zsh build-essential; do
        if ! dpkg -s "$pkg" &>/dev/null; then
            NEEDED+=("$pkg")
        fi
    done

    if [[ ${#NEEDED[@]} -gt 0 ]]; then
        sudo apt-get update -qq
        sudo apt-get install -y -qq "${NEEDED[@]}"
        done_msg
    else
        skip_msg
    fi
elif [[ "$PKG_MGR" == "dnf" ]]; then
    NEEDED=()
    for pkg in git curl zsh gcc gcc-c++ make; do
        if ! rpm -q "$pkg" &>/dev/null; then
            NEEDED+=("$pkg")
        fi
    done

    if [[ ${#NEEDED[@]} -gt 0 ]]; then
        sudo dnf install -y -q "${NEEDED[@]}"
        done_msg
    else
        skip_msg
    fi
fi

# ---------------------------------------------------------------------------
# 2. chezmoi
# ---------------------------------------------------------------------------
step "chezmoi..."

if command -v chezmoi &>/dev/null; then
    skip_msg
else
    sh -c "$(curl -fsLS get.chezmoi.io)" -- -b "$HOME/.local/bin"
    export PATH="$HOME/.local/bin:$PATH"
    done_msg
fi

# ---------------------------------------------------------------------------
# 3. Homebrew (Linuxbrew)
# ---------------------------------------------------------------------------
step "Homebrew (Linuxbrew)..."

if [[ -d /home/linuxbrew/.linuxbrew ]]; then
    eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
    skip_msg
else
    NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
    eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
    done_msg
fi

# ---------------------------------------------------------------------------
# 4. Age encryption key
# ---------------------------------------------------------------------------
step "Age encryption key..."

KEY_FILE="$HOME/.config/chezmoi/key.txt"

if [[ -f "$KEY_FILE" ]]; then
    printf "${DIM}done (key exists)${RESET}\n"
else
    echo
    echo
    echo "  Encrypted files (API keys, credentials) need an age key."
    echo "  You can paste the key now, or skip to set up without encrypted files."
    echo
    printf "  Paste age key (or press Enter to skip): "
    read -r AGE_KEY

    if [[ -n "$AGE_KEY" ]]; then
        mkdir -p "$(dirname "$KEY_FILE")"
        echo "$AGE_KEY" > "$KEY_FILE"
        chmod 600 "$KEY_FILE"
        echo "  ${GREEN}Key saved.${RESET}"
    else
        echo "  ${DIM}Skipped — encrypted files won't be deployed.${RESET}"
    fi
fi

# ---------------------------------------------------------------------------
# 5. chezmoi init
# ---------------------------------------------------------------------------
step "chezmoi init..."

if [[ -d "$HOME/.local/share/chezmoi" ]]; then
    # Source already cloned: (re)render only the config so a --home/--work
    # answer still lands.
    chezmoi init "${CHEZMOI_INIT_ARGS[@]}"
    skip_msg
else
    chezmoi init "${CHEZMOI_INIT_ARGS[@]}" erewhon/dotfiles
    done_msg
fi

# ---------------------------------------------------------------------------
# 6. chezmoi apply
# ---------------------------------------------------------------------------
step "chezmoi apply..."

chezmoi apply
done_msg

# ---------------------------------------------------------------------------
# 7. Login shell
# ---------------------------------------------------------------------------
step "Login shell → zsh..."

if [[ "${SHELL:-}" == */zsh ]]; then
    skip_msg
else
    ZSH_PATH=$(which zsh)
    if grep -qx "$ZSH_PATH" /etc/shells; then
        sudo chsh -s "$ZSH_PATH" "$USER"
        done_msg
    else
        echo "$ZSH_PATH" | sudo tee -a /etc/shells >/dev/null
        sudo chsh -s "$ZSH_PATH" "$USER"
        done_msg
    fi
fi

# ---------------------------------------------------------------------------
# Summary
# ---------------------------------------------------------------------------
echo
HOST_ROLE=$(chezmoi execute-template '{{ $h := includeTemplate "host-profile" . | fromJson }}{{ if $h.is_personal }}home{{ else }}work{{ end }} {{ if $h.is_remote }}remote{{ else }}desktop{{ end }} node' 2>/dev/null || echo "unknown")
echo "${BOLD}Setup complete!${RESET} This machine is configured as a ${BOLD}${HOST_ROLE}${RESET}"
echo "  (change with: bootstrap --home | --work | --desktop | --remote, or chezmoi init --prompt --promptBool home=true)"
echo "Next steps:"
echo "  - Log out and back in (or run: ${BOLD}exec zsh${RESET})"
echo "  - In tmux, press ${BOLD}prefix + I${RESET} to install plugins"
if [[ ! -f "$KEY_FILE" ]]; then
    echo "  - To enable encrypted files later, place your age key at:"
    echo "    ${DIM}${KEY_FILE}${RESET}"
fi
echo
