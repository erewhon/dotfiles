{{- /* Fable is only available at home: the model pin and its effort override are personal-only. */ -}}
{{- $host := includeTemplate "host-profile" . | fromJson -}}
{
  "cleanupPeriodDays": 365,
  "env": {
    "CLAUDE_CODE_ENABLE_TELEMETRY": "1",
    "OTEL_METRICS_EXPORTER": "otlp",
    "OTEL_LOGS_EXPORTER": "otlp",
    "OTEL_EXPORTER_OTLP_PROTOCOL": "http/json",
    "OTEL_EXPORTER_OTLP_ENDPOINT": "http://127.0.0.1:4318",
    "OTEL_METRIC_EXPORT_INTERVAL": "10000"
  },
  "permissions": {
    "allow": [
      "Bash(upsc *)",
      "Bash(incus list *)",
      "Bash(systemctl is-active *)",
      "Bash(systemctl is-enabled *)",
      "Bash(systemctl status *)",
      "Bash(jj status *)",
      "Bash(jj diff *)",
      "Bash(git filter-repo *)",
      "Bash(git-filter-repo *)",
      "mcp__nous__query_tasks",
      "mcp__nous__get_task_spec",
      "mcp__nous__task_summary",
      "mcp__nous__search_pages",
      "mcp__nous__get_page",
      "mcp__nous__get_database",
      "mcp__context7__resolve-library-id",
      "mcp__context7__query-docs",
      "mcp__plugin_claude-mem_mcp-search__get_observations",
      "mcp__plugin_claude-mem_mcp-search__search",
      "mcp__gaol__gaol_remote_list_hosts",
      "mcp__playwright__browser_take_screenshot",
      "Bash(journal *)"
    ]
  },
{{- if $host.is_personal }}
  "model": "fable",
{{- end }}
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.local/bin/meta themes --brief 2>/dev/null || true",
            "timeout": 10,
            "statusMessage": "Loading weekly themes"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/stop.py --chat"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "curl -sX POST http://localhost:8070/api/webhook -H 'Content-Type: application/json' -d \"{\\\"session\\\":\\\"$(tmux display-message -p '#{session_name}' 2>/dev/null)\\\",\\\"agent_type\\\":\\\"claude\\\",\\\"status\\\":\\\"idle\\\",\\\"session_id\\\":\\\"$(jq -r '.session_id // empty' 2>/dev/null)\\\"}\" &>/dev/null &"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/notification.py --notify"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "curl -sX POST http://localhost:8070/api/webhook -H 'Content-Type: application/json' -d \"{\\\"session\\\":\\\"$(tmux display-message -p '#{session_name}' 2>/dev/null)\\\",\\\"agent_type\\\":\\\"claude\\\",\\\"status\\\":\\\"waiting\\\",\\\"hook_event\\\":\\\"Notification\\\",\\\"detail\\\":\\\"$CLAUDE_NOTIFICATION\\\",\\\"session_id\\\":\\\"$(jq -r '.session_id // empty' 2>/dev/null)\\\"}\" &>/dev/null &"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "auto",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/pre_compact.py --backup"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "curl -sX POST http://localhost:8070/api/webhook -H 'Content-Type: application/json' -d \"{\\\"session\\\":\\\"$(tmux display-message -p '#{session_name}' 2>/dev/null)\\\",\\\"agent_type\\\":\\\"claude\\\",\\\"status\\\":\\\"running\\\",\\\"detail\\\":\\\"$CLAUDE_TOOL\\\",\\\"session_id\\\":\\\"$(jq -r '.session_id // empty' 2>/dev/null)\\\"}\" &>/dev/null &"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "claude-mem@thedotmack": true,
    "typescript-lsp@claude-plugins-official": true,
    "filetree@claude-code-filetree": true,
    "blast-radius@claude-code-playground-mods": true,
    "replay-theater@claude-code-playground-mods": true
  },
  "extraKnownMarketplaces": {
    "thedotmack": {
      "source": {
        "source": "github",
        "repo": "thedotmack/claude-mem"
      }
    },
    "hellosverre-mods": {
      "source": {
        "source": "github",
        "repo": "hellosverre/claude-skins"
      }
    },
    "claude-code-filetree": {
      "source": {
        "source": "github",
        "repo": "data-goblin/claude-code-filetree"
      }
    },
    "claude-code-playground-mods": {
      "source": {
        "source": "directory",
        "path": "{{ .chezmoi.homeDir }}/.local/share/claude-code-playground/claude-code/mods"
      }
    }
  },
  "effortLevel": "high",
{{- if $host.is_personal }}
  "modelSettings": {
    "claude-fable-5": {
      "effortLevel": "xhigh"
    }
  },
{{- end }}
  "pluginConfigs": {
    "filetree@claude-code-filetree": {
      "options": {
        "activity": "reads and writes",
        "glyphs": "auto",
        "follow": "on",
        "column": "date"
      }
    }
  },
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true,
  "switchModelsOnFlag": false,
  "remoteControlAtStartup": true,
  "agentPushNotifEnabled": true,
  "mcpServers": {}
}
